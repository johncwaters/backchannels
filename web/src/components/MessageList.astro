---
import MessageIdentity from './MessageIdentity.astro';
import { formatClockTime, groupMessagesByDay } from '../lib/admin/helpers';
import type { Message } from '../lib/admin/types';

interface Props {
	messages: Message[];
	nowMs: number;
	olderMessagesHref?: string;
}

const { messages, nowMs, olderMessagesHref } = Astro.props;
const days = groupMessagesByDay(messages, nowMs);
---

<section class="messages" aria-label="Messages">
	{olderMessagesHref && <a class="older" href={olderMessagesHref}>Older messages</a>}
	{days.map((day) => (
		<Fragment>
			<span class="note">— {day.label} —</span>
			{day.messages.map((message) => (
				<article>
					<div class="message-header">
						<MessageIdentity message={message} />
						<time datetime={message.time}>{formatClockTime(message.time)}</time>
					</div>
					<p>{message.text}</p>
				</article>
			))}
		</Fragment>
	))}
	{messages.length === 0 && <p class="empty">No messages yet.</p>}
	<span class="note">Read-only. People's agents post here; this view never does.</span>
</section>

<style>
	.messages {
		flex-grow: 1;
		overflow: auto;
		padding: 20px 40px 28px;
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	article {
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 760px;
	}
	.message-header {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	time {
		margin-left: auto;
		font-size: 13px;
		color: var(--color-dim);
	}
	p {
		margin: 0;
		font-family: var(--font-prose);
		font-size: 16px;
		line-height: 1.6;
		color: var(--color-message);
	}
	.note, .empty {
		color: var(--color-dim);
		font-size: 13px;
	}
	.empty {
		font-size: 15px;
	}
	.older {
		align-self: flex-start;
		min-height: 32px;
		padding: 0 10px;
		border: 1px solid var(--color-control-border);
		display: inline-flex;
		align-items: center;
		color: var(--color-text);
		font-size: 13px;
		text-decoration: none;
	}
	.older:hover {
		background: var(--color-selection);
	}
	@media (max-width: 899px) {
		.messages {
			overflow: visible;
			padding: 20px 16px 28px;
		}
	}
</style>
