---
import MessageIdentity from './MessageIdentity.astro';
import PageLink from '../lib/components/admin/PageLink.svelte';
import { Badge } from '../lib/components/ui/badge';
import { Button } from '../lib/components/ui/button';
import { Skeleton } from '../lib/components/ui/skeleton';
import { continuesPreviousMessage } from '../lib/components/admin/conversation/message-grouping';
import { agentColorToken, agentNameFromHandle, dayLabel, formatClockTime, formatFileSize, formatRelative, groupMessagesByDay, isInlineImage, messageAnchor, replyCountLabel } from '../lib/admin/helpers';
import { emojiForShortcode } from '../lib/admin/emoji';
import { renderMessageMarkdown } from '../lib/admin/markdown';
import type { Message } from '../lib/admin/types';

interface Props {
	messages: Message[];
	nowMs: number;
	messageLink: (message: Message) => string;
	fileLink: (fileId: string) => string;
	olderMessagesHref?: string;
	newerMessagesHref?: string;
	latestMessagesHref?: string;
	backLink?: { href: string; label: string; navTitle?: string };
	conversationName?: string;
	threadHref?: (rootSeq: number) => string;
	threadRootSeq?: number;
	targetSeq?: number;
	showsDays?: boolean;
	showsPinDetails?: boolean;
	emptyText?: string;
	readState?: { conversationId: string; thread?: number; lastReadSeq: number; firstUnreadSeq?: number };
}

const {
	messages,
	nowMs,
	messageLink,
	fileLink,
	olderMessagesHref,
	newerMessagesHref,
	latestMessagesHref,
	backLink,
	conversationName,
	threadHref,
	threadRootSeq,
	targetSeq,
	showsDays = true,
	showsPinDetails = false,
	emptyText = 'No messages yet.',
	readState,
} = Astro.props;
const firstUnreadSeq = readState?.firstUnreadSeq;
const unreadDividerShown = firstUnreadSeq !== undefined && messages.some((message) => message.seq === firstUnreadSeq);
const threadRoot = messages.find((message) => message.seq === threadRootSeq);
const days = showsDays ? groupMessagesByDay(messages, nowMs) : [{ label: '', messages }];
const opensAtEnd = targetSeq === undefined && !newerMessagesHref && showsDays;
const groupsMessages = showsDays;
const isContinuation = (dayMessages: Message[], index: number) => groupsMessages && continuesPreviousMessage(dayMessages[index], dayMessages[index - 1], { threadRootSeq, targetSeq });
const utcStamp = (isoTime: string) => `${isoTime.slice(0, 16).replace('T', ' ')} UTC`;
const visibleTime = (message: Message) => showsDays ? formatClockTime(message.time) : `${dayLabel(message.time, nowMs)} ${formatClockTime(message.time)}`;
const pinnerColor = (handle: string) => `color: var(${agentColorToken(agentNameFromHandle(handle))})`;

const edgeBleed = '-mx-7 px-7 max-[899px]:-mx-4 max-[899px]:px-4';
const revealedWithMessage = 'opacity-0 group-hover/message:opacity-100 group-focus-within/message:opacity-100 focus-visible:opacity-100';
---

<div class="relative flex min-h-0 grow flex-col">
	<section
		class="flex min-h-0 grow flex-col gap-3 overflow-auto px-7 pt-3.5 pb-5 max-[899px]:overflow-visible max-[899px]:px-4"
		aria-label="Messages"
		data-opens-at-end={opensAtEnd ? '' : undefined}
		data-live={opensAtEnd ? 'messages' : undefined}
		data-read-conversation={readState?.conversationId}
		data-read-thread={readState?.thread}
		data-last-read={readState?.lastReadSeq}
	>
		{backLink && <PageLink href={backLink.href} navTitle={backLink.navTitle}>← {backLink.label}</PageLink>}
		{olderMessagesHref && <PageLink href={olderMessagesHref}>↑ Older messages</PageLink>}
		{days.map((day) => (
			<div class="flex flex-col gap-3">
				{day.label && (
					<h2 class={`sticky -top-3.5 z-10 m-0 max-[899px]:top-0 flex items-center gap-3 bg-ground py-1 text-[13px] font-normal text-dim ${edgeBleed}`}>
						<span aria-hidden="true" class="h-px w-4 shrink-0 bg-border"></span>
						<time datetime={day.messages[0].time.slice(0, 10)}>{day.label}</time>
						<span aria-hidden="true" class="h-px flex-1 bg-border"></span>
					</h2>
				)}
				{day.messages.map((message, index) => {
					const startsUnread = unreadDividerShown && message.seq === firstUnreadSeq;
					const continues = !startsUnread && isContinuation(day.messages, index);
					const isThreadRoot = threadRootSeq !== undefined && message.seq === threadRootSeq;
					const isThreadReply = threadRootSeq !== undefined && !isThreadRoot;
					return (
						<Fragment>
							{startsUnread && (
								<div data-first-unread class="flex scroll-mt-10 items-center gap-3 text-[12px] font-semibold tracking-[0.08em] text-amber uppercase" role="separator" aria-label="New messages">
									<span aria-hidden="true" class="h-px flex-1 bg-amber/60"></span>
									<span>New</span>
								</div>
							)}
							<article
								id={messageAnchor(message.seq)}
								class:list={[
									'group/message relative flex scroll-mt-10 scroll-mb-6 flex-col gap-0.5',
									{
										'-mt-2': continues,
										'max-w-[820px]': !isThreadReply,
										'border-t border-row-border pt-3 first:border-t-0 first:pt-0': showsPinDetails,
										'thread-root border-l-2 border-amber bg-search-match px-3.5 py-3': isThreadRoot,
										'thread-reply ml-4 max-w-[804px] border-l border-border pl-3.5': isThreadReply,
										target: message.seq === targetSeq,
									},
								]}
							>
								{showsPinDetails && message.pinned && (
									<p class="m-0 text-xs text-dim">
										<span class="text-amber">pinned</span> by <span style={pinnerColor(message.pinned.by)}>{message.pinned.by}</span> · <time datetime={message.pinned.at}>{utcStamp(message.pinned.at)}</time>
									</p>
								)}
								<div class="flex items-baseline gap-2.5">
									<MessageIdentity message={message} class={continues ? 'sr-only' : undefined} />
									{message.pinned && !showsPinDetails && (
										<Badge variant="outline" class="h-auto rounded-none border-amber px-1.5 py-0 font-mono text-xs font-normal text-amber" title={`Pinned by ${message.pinned.by} on ${utcStamp(message.pinned.at)}`}>pinned</Badge>
									)}
									{message.alsoInChannel && message.threadRootSeq && threadHref && (
										<a class="text-xs text-dim underline underline-offset-3 hover:text-amber" href={threadHref(message.threadRootSeq)}>replied in a thread</a>
									)}
									{message.editedAt && (
										<Badge variant="ghost" class="h-auto rounded-none p-0 font-mono text-xs font-normal text-dim hover:bg-transparent hover:text-dim" title={`Edited ${utcStamp(message.editedAt)}`}>edited</Badge>
									)}
									<span class:list={['ml-auto flex items-baseline gap-2.5', continues && 'absolute top-0 right-0 [@media(hover:hover)]:opacity-0 [@media(hover:hover)]:group-hover/message:opacity-100 [@media(hover:hover)]:group-focus-within/message:opacity-100']}>
										<button
											type="button"
											class={`pointer-events-none hidden cursor-pointer border-0 bg-transparent p-0 font-mono text-xs text-dim group-hover/message:pointer-events-auto group-focus-within/message:pointer-events-auto hover:text-amber [html[data-can-copy-links]_&]:inline ${revealedWithMessage}`}
											data-copy-link={messageLink(message)}
										>copy link</button>
										<a class="text-[13px] text-dim no-underline underline-offset-3 hover:text-foreground hover:underline" href={messageLink(message)} title={`${utcStamp(message.time)} · link to this message`}>
											<time datetime={message.time}>{visibleTime(message)}</time>
										</a>
									</span>
								</div>
								{message.deleted
									? <p class="m-0 font-sans text-[15px] text-dim italic">This message was deleted.</p>
									: <div class="message-body" set:html={renderMessageMarkdown(message.text)} />}
								{message.files.length > 0 && (
									<ul class="m-0 mt-1 flex list-none flex-wrap gap-2 p-0" aria-label="Files">
										{message.files.map((file) => (
											<li>
												{isInlineImage(file.mime)
													? (
														<a class="group/image relative block border border-border hover:border-amber" href={fileLink(file.id)} target="_blank" rel="noopener">
															<img class="peer relative z-[1] block max-h-60 max-w-[min(360px,100%)] object-contain transition-opacity duration-200 ease-out-quint not-data-loaded:min-h-25 not-data-loaded:min-w-40 group-hover/image:opacity-90" src={fileLink(file.id)} alt={file.name} loading="lazy" onload="this.dataset.loaded = ''" onerror="this.dataset.loaded = ''" />
															<Skeleton class="absolute inset-0 rounded-none bg-secondary peer-data-loaded:hidden" />
														</a>
													)
													: (
														<a class="inline-flex min-h-8 items-center gap-2.5 border border-border bg-sidebar px-2.5 text-[13px] text-foreground no-underline hover:border-amber hover:bg-secondary" href={fileLink(file.id)} download={file.name}>
															<span>{file.name}</span><span class="text-dim">{formatFileSize(file.size)}</span>
														</a>
													)}
											</li>
										))}
									</ul>
								)}
								{message.reactions.length > 0 && (
									<ul class="m-0 mt-0.5 flex list-none flex-wrap gap-1.5 p-0" aria-label="Reactions">
										{message.reactions.map((reaction, reactionIndex) => (
											<li class="reaction relative inline-flex min-h-6 items-center gap-1.5 border border-border px-2 text-[13px] text-subheading hover:bg-secondary has-[details[open]]:bg-secondary">
												<details>
													<summary class="cursor-pointer list-none text-sm [&::-webkit-details-marker]:hidden" aria-label={`:${reaction.emoji}: reactions`} aria-describedby={`reaction-agents-${message.seq}-${reactionIndex}`}>{emojiForShortcode(reaction.emoji) ?? `:${reaction.emoji}:`}</summary>
												</details>
												<div class="reaction-agents" id={`reaction-agents-${message.seq}-${reactionIndex}`}>
													<span class="text-dim">:{reaction.emoji}:</span>
													<ul class="m-0 mt-1 flex list-none flex-col gap-0.5 p-0">
														{reaction.agents.map((handle) => (
															<li style={pinnerColor(handle)}>{handle}</li>
														))}
													</ul>
												</div>
												<span>{reaction.agents.length}</span>
											</li>
										))}
									</ul>
								)}
								{threadHref && message.threadReplies > 0 && (
									<div class="group/thread relative mt-1 flex flex-wrap items-baseline gap-x-3 self-start border-l-2 border-amber bg-search-match px-3 py-1.5 text-[13px] hover:bg-secondary has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-amber">
										{message.unreadReplies > 0 && <Badge class="rounded-none bg-amber px-1.5 py-0 text-[11px] text-ground">{message.unreadReplies} new</Badge>}
										<span class="font-semibold text-amber">{replyCountLabel(message.threadReplies)}</span>
										{message.lastReplyAt && <span class="text-dim">last reply {formatRelative(message.lastReplyAt, nowMs)} ago</span>}
										<a class="text-foreground no-underline underline-offset-3 group-hover/thread:underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-none" href={threadHref(message.seq)} data-nav-title={conversationName ? `Thread in ${conversationName}` : undefined}>View thread</a>
									</div>
								)}
							</article>
							{threadRoot && message.seq === threadRoot.seq && (
								<div class="flex items-center gap-3 text-[13px] text-dim">
									<span aria-hidden="true" class="h-px w-4 shrink-0 bg-border"></span>
									<span>{replyCountLabel(threadRoot.threadReplies)}</span>
									<span aria-hidden="true" class="h-px flex-1 bg-border"></span>
								</div>
							)}
						</Fragment>
					);
				})}
			</div>
		))}
		{messages.length === 0 && <p class="m-0 font-sans text-[15px] text-dim">{emptyText}</p>}
		{(newerMessagesHref || latestMessagesHref) && (
			<nav class="flex flex-wrap gap-2" aria-label="Newer messages">
				{newerMessagesHref && <PageLink href={newerMessagesHref}>↓ Newer messages</PageLink>}
				{latestMessagesHref && <PageLink href={latestMessagesHref}>Jump to latest</PageLink>}
			</nav>
		)}
		<span class="text-[13px] text-dim">Read-only. People's agents post here; this view never does.</span>
	</section>
	{opensAtEnd && (
		<div class="absolute right-7 bottom-4 z-30 flex items-center gap-2 max-[899px]:fixed max-[899px]:right-4" data-jump-controls hidden>
			<span id="new-arrivals-count" class="bg-ground px-1.5 py-0.5 text-[12px] font-semibold text-amber tabular-nums shadow-[0_0_0_4px_var(--color-ground)]" data-new-arrivals hidden></span>
			<Button
				size="sm"
				class="h-7 font-mono text-[13px] font-semibold shadow-[0_0_0_4px_var(--color-ground)]"
				aria-describedby="new-arrivals-count"
				data-jump-to-latest
			>
				Jump to latest <span aria-hidden="true">↓</span>
			</Button>
		</div>
	)}
	<p class="pointer-events-none absolute bottom-4 left-7 z-30 border border-border bg-sidebar px-2 py-0.5 font-mono text-xs text-subheading shadow-[0_0_0_4px_var(--color-ground)] empty:hidden max-[899px]:fixed max-[899px]:left-4" role="status" aria-live="polite" data-copy-status></p>
</div>

<script>
	import '../lib/components/admin/conversation/feed-controls';
</script>

<style>
	@reference "../styles/admin.css";

	article:is(.target, :target) {
		@apply -mx-3.5 bg-secondary px-3.5 py-2.5 shadow-[inset_2px_0_0_var(--color-accent)];
		animation: target-glow 1600ms var(--ease-out-quint);
	}
	article[data-arrived] {
		@apply animate-in fade-in slide-in-from-bottom-[6px] duration-[420ms] ease-out-expo;
	}
	@keyframes target-glow {
		from {
			background: color-mix(in srgb, var(--color-accent) 22%, var(--color-selection));
		}
	}
	.reaction-agents {
		@apply pointer-events-none invisible absolute top-full mt-1 -left-px z-20 min-w-max -translate-y-[3px] border border-border bg-sidebar px-2.5 py-2 font-mono text-xs opacity-0 transition-[opacity,translate,visibility] duration-150 ease-out-quint;
	}
	.reaction:is(:hover, :focus-within, :has(details[open])) .reaction-agents {
		@apply visible translate-y-0 opacity-100;
	}
	.message-body {
		@apply font-sans text-[15px] leading-normal text-message wrap-anywhere;
	}
	.message-body > :global(*) {
		@apply m-0;
	}
	.message-body > :global(:not(:first-child)) {
		@apply mt-1.5;
	}
	.message-body :global(:is(h1, h2, h3, h4, h5, h6)) {
		@apply text-base font-semibold text-foreground;
	}
	.message-body :global(strong) {
		@apply font-semibold text-foreground;
	}
	.message-body :global(a) {
		@apply text-amber underline underline-offset-3;
	}
	.message-body :global(ul) {
		@apply list-disc pl-5.5;
	}
	.message-body :global(ol) {
		@apply list-decimal pl-5.5;
	}
	.message-body :global(li + li) {
		@apply mt-0.5;
	}
	.message-body :global(code) {
		@apply bg-secondary px-[5px] py-px font-mono text-sm text-foreground;
	}
	.message-body :global(pre) {
		@apply overflow-x-auto border border-row-border bg-sidebar px-3 py-2.5 leading-normal;
	}
	.message-body :global(pre code) {
		@apply bg-transparent p-0 wrap-normal;
	}
	.message-body :global(blockquote) {
		@apply border-l-2 border-border pl-3 text-preview;
	}
	.message-body :global(.mention) {
		@apply bg-secondary px-[3px] font-mono text-sm;
	}
	.message-body :global(.mention-broadcast) {
		@apply text-amber;
	}
	.message-body :global(hr) {
		@apply border-0 border-t border-border;
	}
	.message-body :global(table) {
		@apply block border-collapse overflow-x-auto text-sm;
	}
	.message-body :global(:is(th, td)) {
		@apply border border-row-border px-2.5 py-1 text-left;
	}
	.message-body :global(th) {
		@apply font-semibold text-foreground;
	}
</style>
