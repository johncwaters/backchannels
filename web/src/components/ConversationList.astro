---
import { adminHref, conversationHref, formatRelative, hiddenConversationsLabel, type buildSidebarGroups } from '../lib/admin/helpers';
import type { DirectoryKind, Scope } from '../lib/admin/types';
import { buttonVariants } from '../lib/components/ui/button';
import PrivacyMarker from '../lib/components/admin/directory/PrivacyMarker.svelte';
import { conversationLabel, messagesTodayLabel, privacyMarkerFor } from '../lib/components/admin/directory/conversation-labels';
import { cn } from '../lib/utils';

interface Props {
	groups: ReturnType<typeof buildSidebarGroups>;
	nowMs: number;
	scope: Scope;
	selectedConversation?: string;
	directoryKind?: DirectoryKind;
	viewerEmail?: string;
}

const { groups, nowMs, scope, selectedConversation, directoryKind, viewerEmail } = Astro.props;
const rowClass = 'conversation group flex min-w-0 flex-col px-2.5 py-[5px] text-foreground no-underline shadow-[inset_0_0_0_var(--color-amber)] outline-none hover:bg-secondary focus-visible:bg-secondary focus-visible:shadow-[inset_0_0_0_1px_var(--color-amber)] aria-[current=page]:bg-secondary aria-[current=page]:shadow-[inset_2px_0_0_var(--color-amber)]';
const browseClass = cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'mx-2.5 mt-1 self-start bg-transparent font-mono text-[13px] font-normal text-foreground dark:bg-transparent aria-[current=page]:border-amber aria-[current=page]:text-amber');
---

<nav aria-label="Conversations" data-live="sidebar" class="flex grow flex-col gap-3.5 overflow-auto px-1.5 pt-2.5 pb-3.5 max-[899px]:overflow-visible">
	{groups.map((group) => (
		<section class="flex min-w-0 flex-col gap-0.5">
			<div class="flex items-baseline justify-between gap-2 px-2 pb-1.5 text-xs text-dim">
				<h2 class="m-0 text-[length:inherit] font-normal tracking-[0.08em]">{group.title}</h2>
				<span class="whitespace-nowrap tabular-nums">{group.conversations.length} of {group.total}</span>
			</div>
			{group.conversations.map((conversation) => {
				const label = conversationLabel(conversation, viewerEmail);
				return (
					<a
						class={rowClass}
						href={conversationHref(conversation.id, scope)}
						aria-current={conversation.id === selectedConversation ? 'page' : undefined}
						data-unread={conversation.unread > 0 ? conversation.unread : undefined}
						data-nav-title={conversation.name}
						title={label.fullName !== label.shownName ? label.fullName : undefined}
					>
						<span class="flex min-w-0 items-center gap-1.5">
							{conversation.unread > 0 && (
								<span data-unread-badge class="shrink-0 bg-amber px-1.5 text-[11px] leading-4 font-semibold text-ground tabular-nums" title={`${conversation.unread} unread`}>
									<span aria-hidden="true">{conversation.unread > 99 ? '99+' : conversation.unread}</span>
									<span class="sr-only">{conversation.unread} unread</span>
								</span>
							)}
							<PrivacyMarker marker={privacyMarkerFor(conversation)} />
							<strong class="min-w-0 truncate text-[13px] font-semibold group-data-[unread]:text-white group-aria-[current=page]:text-amber">{label.shownName}</strong>
							{label.hiddenMemberCount > 0 && <span class="shrink-0 text-xs text-dim">+{label.hiddenMemberCount}</span>}
							<span class="last-active ml-auto shrink-0 text-xs whitespace-nowrap text-dim tabular-nums group-data-[updated]:animate-[sidebar-pulse-accent_1400ms_var(--ease-out-quint)]">{formatRelative(conversation.lastActivity, nowMs)}</span>
						</span>
						<span class="flex min-w-0 items-baseline gap-2">
							<span class="preview min-w-0 grow truncate font-sans text-xs text-preview">{conversation.preview}</span>
							{conversation.messagesToday > 0 && (
								<span class="shrink-0 text-[11px] whitespace-nowrap text-dim tabular-nums" title={messagesTodayLabel(conversation.messagesToday)}>
									<span aria-hidden="true">{conversation.messagesToday} today</span>
									<span class="sr-only">{messagesTodayLabel(conversation.messagesToday)}</span>
								</span>
							)}
						</span>
					</a>
				);
			})}
			<div class="flex items-center gap-2">
				<a
					class={browseClass}
					href={adminHref(`/admin/browse/${group.kind}`, scope)}
					aria-current={directoryKind === group.kind ? 'page' : undefined}
					data-nav-title={group.kind === 'public' ? 'All public channels' : 'Your private chats'}
				>Browse all</a>
				{group.hiddenCount > 0 && <span class="mt-1 text-xs text-amber tabular-nums">{hiddenConversationsLabel(group.kind, group.hiddenCount)}</span>}
			</div>
		</section>
	))}
</nav>

<style is:global>
	@keyframes sidebar-pulse-accent {
		from {
			color: var(--color-accent);
		}
	}
</style>
