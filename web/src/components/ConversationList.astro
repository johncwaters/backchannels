---
import { adminHref, conversationHref, formatRelative, type buildSidebarGroups } from '../lib/admin/helpers';
import type { DirectoryKind, Scope } from '../lib/admin/types';

interface Props {
	groups: ReturnType<typeof buildSidebarGroups>;
	nowMs: number;
	scope: Scope;
	selectedConversation?: string;
	directoryKind?: DirectoryKind;
}

const { groups, nowMs, scope, selectedConversation, directoryKind } = Astro.props;
---

<nav aria-label="Conversations" data-live="sidebar">
	{groups.map((group) => (
		<section>
			<div class="group-header">
				<h2>{group.title}</h2>
				<span>{group.conversations.length} of {group.total}</span>
			</div>
			{group.conversations.map((conversation) => (
				<a
					class="conversation"
					href={conversationHref(conversation.id, scope)}
					aria-current={conversation.id === selectedConversation ? 'page' : undefined}
				>
					<span class="conversation-header">
						<strong>{conversation.name}</strong>
						<span class="last-active">{formatRelative(conversation.lastActivity, nowMs)}</span>
					</span>
					<span class="preview">{conversation.preview}</span>
				</a>
			))}
			<a
				class:list={['browse', { selected: directoryKind === group.kind }]}
				href={adminHref(`/admin/browse/${group.kind}`, scope)}
				aria-current={directoryKind === group.kind ? 'page' : undefined}
			>Browse all</a>
		</section>
	))}
</nav>

<style>
	nav {
		flex-grow: 1;
		overflow: auto;
		padding: 10px 6px 14px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	section {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.group-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px;
		padding: 0 8px 6px;
		font-size: 12px;
		color: var(--color-dim);
	}
	h2 {
		margin: 0;
		font-size: inherit;
		font-weight: 400;
		letter-spacing: 0.08em;
	}
	.group-header > span {
		white-space: nowrap;
	}
	a {
		color: var(--color-text);
		text-decoration: none;
	}
	.conversation {
		padding: 5px 10px;
		display: flex;
		flex-direction: column;
		gap: 0;
		min-width: 0;
	}
	.conversation:hover, .selected, .conversation[aria-current='page'] {
		background: var(--color-selection);
	}
	.conversation[aria-current='page'] strong {
		color: var(--color-accent);
	}
	.conversation {
		box-shadow: inset 0 0 0 var(--color-accent);
		transition: background-color 140ms var(--ease-out-quint), box-shadow 180ms var(--ease-out-quint);
	}
	.conversation[aria-current='page'] {
		box-shadow: inset 2px 0 0 var(--color-accent);
	}
	.conversation[data-updated] .last-active {
		animation: pulse-accent 1400ms var(--ease-out-quint);
	}
	@keyframes pulse-accent {
		from {
			color: var(--color-accent);
		}
	}
	.conversation-header {
		display: flex;
		align-items: baseline;
		gap: 8px;
	}
	strong {
		font-size: 13px;
		font-weight: 600;
	}
	.last-active {
		margin-left: auto;
		font-size: 12px;
		color: var(--color-dim);
	}
	.preview {
		font-family: var(--font-prose);
		font-size: 12px;
		color: var(--color-preview);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.browse {
		margin: 4px 10px 0;
		align-self: flex-start;
		min-height: 28px;
		padding: 0 10px;
		border: 1px solid var(--color-control-border);
		display: inline-flex;
		align-items: center;
		font-size: 13px;
	}
	.browse:hover {
		background: var(--color-selection);
	}
	@media (max-width: 899px) {
		nav {
			overflow: visible;
			padding-inline: 6px;
		}
	}
</style>
