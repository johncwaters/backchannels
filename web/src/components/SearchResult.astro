---
import MessageIdentity from './MessageIdentity.astro';
import { dayLabel, formatClockTime, highlightSegments, messageHref, replyCountLabel, snippetAround } from '../lib/admin/helpers';
import type { Scope, SearchMatch } from '../lib/admin/types';

interface Props {
	match: SearchMatch;
	scope: Scope;
	nowMs: number;
}

const { match, scope, nowMs } = Astro.props;
const { message, conversation } = match;
const snippet = snippetAround(message.text, match.ranges);
const segments = highlightSegments(snippet.text, snippet.ranges);
const threadNote = message.threadRootSeq ? 'reply in a thread' : message.threadReplies > 0 ? replyCountLabel(message.threadReplies) : null;
---

<a class="match" href={messageHref(conversation.id, scope, message)}>
	<span class="match-header">
		<MessageIdentity message={message} />
		<span class="conversation">in <span>{conversation.name}</span></span>
		{threadNote && <span class="badge">{threadNote}</span>}
		{message.pinned && <span class="badge pinned">pinned</span>}
		{message.files.length > 0 && <span class="badge">{message.files.length === 1 ? '1 file' : `${message.files.length} files`}</span>}
		<time datetime={message.time}>{dayLabel(message.time, nowMs)} {formatClockTime(message.time)}</time>
	</span>
	<span class="message-text">{segments.map((segment) => segment.isMatch ? <mark>{segment.text}</mark> : segment.text)}</span>
</a>

<style>
	.match {
		padding: 8px 12px;
		background: var(--color-search-match);
		border-left: 2px solid transparent;
		color: inherit;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 800px;
	}
	.match {
		transition: background-color 140ms var(--ease-out-quint), border-color 140ms var(--ease-out-quint);
	}
	.match:hover, .match:focus-visible {
		background: var(--color-selection);
		border-left-color: var(--color-accent);
	}
	.match-header {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 10px;
	}
	.conversation, time {
		font-size: 13px;
		color: var(--color-dim);
	}
	.conversation > span {
		color: var(--color-text);
	}
	.badge {
		font-size: 12px;
		color: var(--color-muted);
		padding: 0 6px;
		border: 1px solid var(--color-control-border);
	}
	.pinned {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
	time {
		margin-left: auto;
	}
	.message-text {
		font-family: var(--font-prose);
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-message);
		white-space: pre-line;
	}
	mark {
		background: var(--color-accent);
		color: var(--color-ground);
		padding: 0 2px;
	}
</style>
