---
import MessageIdentity from './MessageIdentity.astro';
import { Badge } from '../lib/components/ui/badge';
import { dayLabel, formatClockTime, highlightSegments, messageHref, plainSnippetText, replyCountLabel, snippetAround } from '../lib/admin/helpers';
import type { Scope, SearchMatch } from '../lib/admin/types';
import { searchEmojiText } from '../lib/admin/emoji';

interface Props {
	match: SearchMatch;
	scope: Scope;
	nowMs: number;
}

const { match, scope, nowMs } = Astro.props;
const { message, conversation } = match;
const converted = searchEmojiText(message.text, match.ranges);
const snippet = snippetAround(plainSnippetText(converted.text), converted.ranges);
const segments = highlightSegments(snippet.text, snippet.ranges);
const threadNote = message.threadRootSeq ? 'reply in a thread' : message.threadReplies > 0 ? replyCountLabel(message.threadReplies) : null;
const fileCount = message.files.length;
const fileNote = fileCount === 0 ? null : fileCount === 1 ? '1 file' : `${fileCount} files`;
const markerClass = 'h-auto rounded-none px-1.5 py-0 font-mono text-xs font-normal';
---

<a
	class="group flex max-w-[800px] flex-col gap-1 border-l-2 border-transparent bg-search-match px-3 py-2 text-inherit no-underline outline-none hover:border-amber hover:bg-secondary focus-visible:border-amber focus-visible:bg-secondary focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-amber"
	href={messageHref(conversation.id, scope, message)}
	data-nav-title={message.threadRootSeq && !message.alsoInChannel ? `Thread in ${conversation.name}` : conversation.name}
>
	<span class="flex flex-wrap items-baseline gap-x-2.5">
		<MessageIdentity message={message} />
		<span class="max-w-[42ch] min-w-0 truncate text-[13px] text-dim">in <span class="text-foreground">{conversation.name}</span></span>
		{threadNote && <Badge variant="outline" class={`${markerClass} text-muted-foreground`}>{threadNote}</Badge>}
		{message.pinned && <Badge variant="outline" class={`${markerClass} border-amber text-amber`}>pinned</Badge>}
		{fileNote && <Badge variant="outline" class={`${markerClass} text-muted-foreground`}>{fileNote}</Badge>}
		<time class="ml-auto text-[13px] text-dim" datetime={message.time}>{dayLabel(message.time, nowMs)} {formatClockTime(message.time)}</time>
	</span>
	<span class="line-clamp-3 font-sans text-sm leading-normal text-message">{segments.map((segment) => segment.isMatch && segment.text.trim() ? <mark class="bg-amber px-0.5 text-ground">{segment.text}</mark> : segment.text)}</span>
</a>
