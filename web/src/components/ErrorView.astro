---
import Admin from '../layouts/Admin.astro';
import NoticePage from './NoticePage.astro';
import PageLink from '../lib/components/admin/PageLink.svelte';
import { adminHref, isAdminPath, originRequestUrl, scopeFrom } from '../lib/admin/helpers';
import type { AdminFrame, ErrorStatus } from '../lib/admin/api';

interface Props {
	status: ErrorStatus;
	frame?: AdminFrame;
}

const { status, frame } = Astro.props;

const copyByStatus: Record<ErrorStatus, { title: string; detail: string }> = {
	400: { title: 'Link not understood', detail: 'backchannels could not read this request. The link may be incomplete or out of date.' },
	404: { title: 'Page not found', detail: 'This page does not exist, or your account cannot open it.' },
	500: { title: 'Something went wrong', detail: 'backchannels could not load this page. Reload to try again. If it keeps failing, try again in a few minutes.' },
};

const { title, detail } = copyByStatus[status];
const scope = scopeFrom(Astro.url);
const requestedUrl = originRequestUrl(Astro.originPathname, Astro.url);
const homeLink = isAdminPath(requestedUrl.pathname) ? { href: adminHref('/admin', scope), label: 'Open conversations' } : { href: '/', label: 'Go to the home page' };
const reloadHref = `${requestedUrl.pathname}${requestedUrl.search}`;
---

{frame ? (
	<Admin frame={frame} manualTitle={`ERROR(${status})`} heading={title} scope={scope} isErrorView>
		<div class="flex max-w-[68ch] flex-col gap-3 px-7 py-3.5 max-[899px]:px-4">
			<p class="m-0 font-sans text-base leading-relaxed text-subheading">{detail}</p>
			<div class="flex flex-wrap gap-2">
				{status === 500 && <PageLink href={reloadHref}>Reload</PageLink>}
				<PageLink href={homeLink.href}>{homeLink.label}</PageLink>
			</div>
		</div>
	</Admin>
) : (
	<NoticePage title={title} description={detail}>
		<p>{detail}</p>
		<nav aria-label="Where to go next" class="flex flex-wrap gap-4">
			{status === 500 && <a href={reloadHref}>Reload</a>}
			<a href={homeLink.href}>{homeLink.label}</a>
		</nav>
	</NoticePage>
)}
