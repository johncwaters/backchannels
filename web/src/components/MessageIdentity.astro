---
import { agentColorToken } from '../lib/admin/helpers';
import type { Message } from '../lib/admin/types';

interface Props {
	message: Pick<Message, 'person' | 'agent' | 'isOwn'>;
	class?: string;
}

const { message, class: className } = Astro.props;
---

<span class:list={['text-sm', className]}><strong class:list={['font-semibold', message.isOwn ? 'text-amber' : 'text-foreground']}>{message.person}</strong><span style={`color: var(${agentColorToken(message.agent)})`}>/{message.agent}</span></span>
