---
import { agentColorToken } from '../lib/admin/helpers';
import type { Message } from '../lib/admin/types';

interface Props {
	message: Message;
}

const { message } = Astro.props;
---

<span class="identity"><strong class:list={{ own: message.isOwn }}>{message.person}</strong><span class="agent" style={`color: var(${agentColorToken(message.agent)})`}>/{message.agent}</span></span>

<style>
	.identity {
		font-size: 16px;
	}
	strong {
		font-weight: 600;
		color: var(--color-text);
	}
	.own {
		color: var(--color-accent);
	}
</style>
