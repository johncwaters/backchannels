---
import { adminHref, formatRelative } from '../lib/admin/helpers';
import type { Conversation, ConversationKind, ConversationSort, Scope } from '../lib/admin/types';

interface Props {
	conversations: Conversation[];
	kind: ConversationKind;
	scope: Scope;
	sort: ConversationSort;
	filter: string;
	busiest: number;
}

const { conversations, kind, scope, sort, filter, busiest } = Astro.props;
const sortOptions: { id: ConversationSort; label: string }[] = [
	{ id: 'active', label: 'Most active' },
	{ id: 'recent', label: 'Recent' },
	{ id: 'name', label: 'A–Z' },
];
const path = `/admin/browse/${kind}`;
---

<section class="directory" aria-label="Conversation directory">
	<div class="directory-controls">
		<form action={path} method="get">
			<input type="hidden" name="scope" value={scope} />
			<input type="hidden" name="sort" value={sort} />
			<label class="filter-box">
				<span aria-hidden="true">#</span>
				<input type="search" name="filter" value={filter} aria-label="Filter by name or topic" placeholder="Filter by name or topic" />
			</label>
		</form>
		<div class="sort-options" role="group" aria-label="Sort">
			{sortOptions.map((option) => (
				<a href={adminHref(path, scope, { sort: option.id, filter })} class:list={{ active: option.id === sort }} aria-current={option.id === sort ? 'true' : undefined}>{option.label}</a>
			))}
		</div>
		<span class="shown-count">{conversations.length} shown</span>
	</div>
	<div class="table-scroll">
		<table>
			<thead>
				<tr><th scope="col">NAME</th><th scope="col">{kind === 'public' ? 'TOPIC' : 'LATEST'}</th><th scope="col" class="people">PEOPLE</th><th scope="col" class="today">TODAY</th><th scope="col" class="last">LAST</th></tr>
			</thead>
			<tbody>
				{conversations.map((conversation) => (
					<tr>
						<td>
							<span class="name"><a href={adminHref(`/admin/c/${conversation.id}`, scope)}>{conversation.name}</a>{conversation.isMine && <span class="mine-tag">MINE</span>}</span>
						</td>
						<td class="detail"><span>{kind === 'public' ? conversation.topic : conversation.preview}</span></td>
						<td class="people">{conversation.people}</td>
						<td class="today"><span class="activity"><span class="activity-track" aria-hidden="true"><span style={`width: ${Math.round((conversation.messagesToday / busiest) * 90)}px`}></span></span><span>{conversation.messagesToday}</span></span></td>
						<td class="last">{formatRelative(conversation.minutesAgo)}</td>
					</tr>
				))}
			</tbody>
		</table>
		{conversations.length === 0 && <p class="empty">Nothing matches that filter.</p>}
	</div>
</section>

<style>
	.directory {
		flex-grow: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}
	.directory-controls {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 16px;
		padding: 14px 40px;
		border-bottom: 1px solid var(--color-selection);
	}
	form {
		flex: 0 1 324px;
		min-width: 0;
	}
	.filter-box {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border: 1px solid var(--color-control-border);
		color: var(--color-dim);
	}
	input[type='search'] {
		width: 100%;
		min-width: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		font: inherit;
		font-size: 14px;
	}
	.sort-options {
		display: flex;
		border: 1px solid var(--color-control-border);
	}
	.sort-options a {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 0 12px;
		color: var(--color-muted);
		font-size: 13px;
		text-decoration: none;
	}
	.sort-options a:hover {
		background: var(--color-selection);
	}
	.sort-options a.active {
		background: var(--color-accent);
		color: var(--color-ground);
	}
	.shown-count {
		margin-left: auto;
		font-size: 13px;
		color: var(--color-dim);
	}
	.table-scroll {
		flex-grow: 1;
		overflow: auto;
		padding: 0 28px 20px;
	}
	table {
		width: 100%;
		table-layout: fixed;
		border-collapse: collapse;
		font-size: 14px;
		text-align: left;
	}
	th {
		padding: 10px 12px 6px;
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.06em;
		color: var(--color-dim);
	}
	th:first-child {
		width: 25%;
	}
	td {
		padding: 8px 12px;
		border-bottom: 1px solid var(--color-row-border);
		color: var(--color-muted);
	}
	tbody tr {
		position: relative;
	}
	tbody tr:hover, tbody tr:focus-within {
		background: var(--color-selection);
	}
	.name {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
	}
	.name a {
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.name a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.mine-tag {
		padding: 0 6px;
		background: var(--color-accent);
		color: var(--color-ground);
		font-size: 11px;
		font-weight: 600;
	}
	.detail {
		font-family: var(--font-prose);
		color: var(--color-preview);
	}
	.detail > span {
		display: block;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.people {
		width: 50px;
	}
	.today {
		width: 126px;
	}
	.last {
		width: 46px;
		color: var(--color-dim);
	}
	.activity {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.activity-track {
		width: 90px;
		height: 6px;
		background: var(--color-selection);
	}
	.activity-track > span {
		display: block;
		height: 6px;
		background: var(--color-accent);
	}
	.empty {
		margin: 16px 12px;
		font-family: var(--font-prose);
		color: var(--color-dim);
	}
	@media (min-width: 900px) and (max-width: 1100px) {
		.people, .activity-track {
			display: none;
		}
		.today {
			width: 48px;
		}
	}
	@media (max-width: 899px) {
		.directory-controls {
			padding-inline: 16px;
			gap: 12px;
		}
		.table-scroll {
			overflow: visible;
			padding-inline: 16px;
		}
		th, td {
			padding-inline: 0;
		}
		th:first-child {
			width: 45%;
		}
		.detail, th:nth-child(2) {
			padding-inline: 10px;
		}
		.people, .today {
			display: none;
		}
		.last {
			width: 36px;
		}
		.empty {
			margin-inline: 0;
		}
	}
</style>
