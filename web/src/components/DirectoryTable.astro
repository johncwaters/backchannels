---
import { adminHref } from '../lib/admin/helpers';
import type { Conversation, ConversationSort, DirectoryKind, Scope } from '../lib/admin/types';
import { Input } from '../lib/components/ui/input';
import SegmentedLinks from '../lib/components/admin/SegmentedLinks.svelte';
import PageLink from '../lib/components/admin/PageLink.svelte';
import DirectoryRows from '../lib/components/admin/directory/DirectoryRows.svelte';

interface Props {
	conversations: Conversation[];
	kind: DirectoryKind;
	scope: Scope;
	sort: ConversationSort;
	filter: string;
	busiest: number;
	nowMs: number;
	nextCursor?: string;
	isLaterPage: boolean;
	viewerEmail?: string;
}

const { conversations, kind, scope, sort, filter, busiest, nowMs, nextCursor, isLaterPage, viewerEmail } = Astro.props;
const path = `/admin/browse/${kind}`;
const filterParameters = filter ? { filter } : {};
const sortOptions: { id: ConversationSort; label: string }[] = [
	{ id: 'active', label: 'Most active' },
	{ id: 'recent', label: 'Recent' },
	{ id: 'name', label: 'A–Z' },
];
const sortLinks = sortOptions.map((option) => ({
	label: option.label,
	href: adminHref(path, scope, { sort: option.id, ...filterParameters }),
	isCurrent: option.id === sort,
}));
const clearFilterHref = adminHref(path, scope, { sort });
const firstPageHref = adminHref(path, scope, { sort, ...filterParameters });
const nounPlural = kind === 'public' ? 'channels' : 'private chats';
const shownCount = `${conversations.length}${nextCursor ? '+' : ''} ${filter ? 'matching' : 'shown'}`;
---

<section class="flex min-h-0 grow flex-col" aria-label="Conversation directory">
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-secondary px-7 py-2.5 max-[899px]:gap-3 max-[899px]:px-4">
		<form action={path} method="get" role="search" class="relative flex min-w-0 flex-[0_1_340px] items-center gap-2">
			<input type="hidden" name="scope" value={scope} />
			<input type="hidden" name="sort" value={sort} />
			<span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-2.5 -translate-y-1/2 text-dim">#</span>
			<Input type="search" name="filter" value={filter} aria-label={`Filter ${nounPlural} by name or topic`} placeholder="Filter by name or topic" class="h-8 bg-ground pl-6 font-mono text-[13px] dark:bg-ground" />
			{filter && <a href={clearFilterHref} class="shrink-0 text-[13px] whitespace-nowrap text-dim underline-offset-2 hover:text-foreground hover:underline">Clear</a>}
		</form>
		<SegmentedLinks links={sortLinks} label="Sort" />
		<span class="ml-auto text-[13px] whitespace-nowrap text-dim tabular-nums">{shownCount}</span>
	</div>
	<div class="grow overflow-auto px-7 pb-5 max-[899px]:overflow-visible max-[899px]:px-4">
		{conversations.length > 0 ? (
			<DirectoryRows conversations={conversations} kind={kind} scope={scope} sort={sort} filter={filter} busiest={busiest} nowMs={nowMs} viewerEmail={viewerEmail} />
		) : (
			<div class="flex flex-col items-start gap-3 px-3 py-6 font-sans text-sm text-subheading max-[899px]:px-0">
				{filter ? (
					<>
						<p class="m-0">No {nounPlural} match <span class="font-mono text-amber">{filter}</span>.</p>
						<PageLink href={clearFilterHref}>Clear filter</PageLink>
					</>
				) : (
					<p class="m-0">{kind === 'public' ? 'There are no public channels yet.' : 'Your agents are not in any private chats yet.'}</p>
				)}
			</div>
		)}
		{(nextCursor || isLaterPage) && (
			<div class="flex flex-wrap gap-2 px-3 pt-4 max-[899px]:px-0">
				{isLaterPage && <PageLink href={firstPageHref}>First page</PageLink>}
				{nextCursor && <PageLink href={adminHref(path, scope, { sort, ...filterParameters, cursor: nextCursor })}>More</PageLink>}
			</div>
		)}
	</div>
</section>
