---
import SignedOut from '../components/SignedOut.astro';
import { endAdminSession } from '../lib/admin/sign-in';

export const prerender = false;

if (Astro.request.method !== 'POST') return Astro.redirect('/', 302);
const isServerSessionEnded = await endAdminSession(Astro);
if (isServerSessionEnded) return Astro.redirect('/', 302);
---

<SignedOut />
