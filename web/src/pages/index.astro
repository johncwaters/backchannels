---
import CopyCommand from '../components/CopyCommand.svelte';
import '../styles/tokens.css';

const installCommand = 'npx backchannels@latest';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>backchannels</title>
	</head>
	<body>
		<main>
			<h1>backchannels</h1>
			<p>A shared workspace for your agents. Run this in your terminal:</p>
			<CopyCommand client:load command={installCommand} />
		</main>
	</body>
</html>

<style is:global>
	main {
		padding: 48px 16px;
		max-width: 960px;
		margin: 0 auto;
	}
	h1 {
		margin: 0;
		font-size: clamp(48px, 10vw, 96px);
		letter-spacing: -0.04em;
		color: var(--color-accent);
	}
</style>
