---
import Admin from '../../layouts/Admin.astro';
import SearchResult from '../../components/SearchResult.astro';
import SegmentedLinks from '../../lib/components/admin/SegmentedLinks.svelte';
import PageLink from '../../lib/components/admin/PageLink.svelte';
import SearchRefineForm from '../../lib/components/admin/search/SearchRefineForm.svelte';
import SearchSyntaxHelp from '../../lib/components/admin/search/SearchSyntaxHelp.svelte';
import SearchNotice from '../../lib/components/admin/search/SearchNotice.svelte';
import { emptyResultRefinements, otherScope, scopeDescriptions, scopeSwitchLabels } from '../../lib/components/admin/search/search-refinement';
import { failureResponse, loadAdminFrame } from '../../lib/admin/api';
import { adminHref, queryWithin, scopeFrom, searchSortFrom, searchSummary } from '../../lib/admin/helpers';
import type { SearchSort } from '../../lib/admin/types';

export const prerender = false;

const scope = scopeFrom(Astro.url);
const sort = searchSortFrom(Astro.url);
const query = queryWithin(Astro.url.searchParams.get('q') ?? '', Astro.url.searchParams.get('in'));
if (!query) return Astro.redirect(adminHref('/admin', scope), 302);
const loaded = await loadAdminFrame(Astro, scope);
if (loaded instanceof Response) return loaded;
const { adminApi, frame } = loaded;
const cursor = Astro.url.searchParams.get('cursor') ?? undefined;
const searched = await adminApi.search({ query, scope, sort, cursor });
if (!searched.ok && searched.error === 'invalid') return Astro.redirect(adminHref('/admin/search', scope, { q: query, sort }), 302);
if (!searched.ok) return failureResponse(Astro, searched.error);
const { matches, top, problem, nextCursor } = searched.value;
const searchHref = (parameters: { q?: string; scope?: typeof scope; sort?: SearchSort; cursor?: string }) => {
	const { scope: targetScope = scope, cursor: targetCursor, ...rest } = parameters;
	return adminHref('/admin/search', targetScope, { q: query, sort, ...rest, ...(targetCursor ? { cursor: targetCursor } : {}) });
};
const sortLinks = ([
	{ id: 'relevant', label: 'Most relevant' },
	{ id: 'recent', label: 'Newest first' },
] satisfies { id: SearchSort; label: string }[]).map((option) => ({ label: option.label, href: searchHref({ sort: option.id }), isCurrent: sort === option.id }));
const alternateScope = otherScope(scope);
const isFirstPage = cursor === undefined;
const hasNoResults = !problem && matches.length === 0 && isFirstPage;
const refinements = hasNoResults ? emptyResultRefinements(query, scope) : [];
const conversationCount = new Set(matches.map((match) => match.conversation.id)).size;
const subheading = problem || hasNoResults ? undefined : searchSummary({ matchCount: matches.length, conversationCount, cursor, hasNextCursor: Boolean(nextCursor) });
const refineInputId = 'search-refine-query';
const sectionHeadingClass = 'm-0 mt-2 text-xs font-normal tracking-[0.08em] text-dim uppercase';
const inlineLinkClass = 'text-amber underline decoration-amber/40 underline-offset-2 hover:decoration-amber focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-amber';
---

<Admin
	frame={frame}
	manualTitle="SEARCH(1)"
	heading={`“${query}”`}
	subheading={subheading}
	scope={scope}
	query={query}
>
	<div class="flex flex-col gap-2.5 px-7 pt-3 max-[899px]:px-4">
		<SearchRefineForm query={query} scope={scope} sort={sort} inputId={refineInputId} />
		<div class="flex flex-wrap items-center gap-x-5 gap-y-2.5">
			<SegmentedLinks links={sortLinks} label="Sort results" />
			<SearchSyntaxHelp targetInputId={refineInputId} />
			<p class="m-0 text-[13px] text-dim">
				Searching {scopeDescriptions[scope]} · <a class={inlineLinkClass} href={searchHref({ scope: alternateScope })}>{scopeSwitchLabels[alternateScope]}</a>
			</p>
		</div>
	</div>
	<section class="flex grow flex-col gap-1.5 overflow-auto px-7 pt-3 pb-5 max-[899px]:overflow-visible max-[899px]:px-4" aria-label="Search results">
		{problem && <SearchNotice tone="problem" title="Search could not run">{problem}</SearchNotice>}
		{hasNoResults && (
			<SearchNotice tone="note" title="No matches">
				<p class="m-0">Nobody's agent has written that yet. Try fewer or other words, or a prefix such as <code class="font-mono text-[13px] text-amber">deploy*</code>.</p>
				{refinements.length > 0 && (
					<ul class="m-0 mt-2 flex list-none flex-col gap-1 p-0 font-mono text-[13px]">
						{refinements.map((refinement) => (
							<li><a class={inlineLinkClass} href={searchHref({ q: refinement.query, scope: refinement.scope })}>{refinement.label}</a>{refinement.query !== query && <span class="text-dim"> → {refinement.query}</span>}</li>
						))}
					</ul>
				)}
			</SearchNotice>
		)}
		{!problem && matches.length === 0 && !isFirstPage && <SearchNotice tone="note">No more matches.</SearchNotice>}
		{top && top.length > 0 && (
			<Fragment>
				<h2 class={sectionHeadingClass}>Best matches</h2>
				{top.map((match) => <SearchResult match={match} scope={scope} nowMs={frame.nowMs} />)}
				<h2 class={sectionHeadingClass}>Newest first</h2>
			</Fragment>
		)}
		{matches.map((match) => <SearchResult match={match} scope={scope} nowMs={frame.nowMs} />)}
		{(nextCursor || !isFirstPage) && (
			<div class="mt-1.5 flex gap-2">
				{!isFirstPage && <PageLink href={searchHref({})}>First page</PageLink>}
				{nextCursor && <PageLink href={searchHref({ cursor: nextCursor })}>More results</PageLink>}
			</div>
		)}
	</section>
</Admin>

<script>
	function insertSyntaxExample(example: HTMLButtonElement): void {
		const popover = example.closest<HTMLElement>('[data-syntax-target]');
		const input = popover ? document.getElementById(popover.dataset.syntaxTarget ?? '') : null;
		if (!(input instanceof HTMLInputElement)) return;
		const { syntaxFixed = '', syntaxEditable = '', syntaxClosing = '' } = example.dataset;
		const separator = input.value && !input.value.endsWith(' ') ? ' ' : '';
		const editableStart = input.value.length + separator.length + syntaxFixed.length;
		input.value = `${input.value}${separator}${syntaxFixed}${syntaxEditable}${syntaxClosing}`;
		popover?.hidePopover();
		input.focus();
		input.setSelectionRange(editableStart, editableStart + syntaxEditable.length);
	}

	document.addEventListener('click', (event) => {
		const example = (event.target as Element | null)?.closest?.('button[data-syntax-editable]');
		if (example instanceof HTMLButtonElement) insertSyntaxExample(example);
	});
</script>
