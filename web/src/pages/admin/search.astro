---
import Admin from '../../layouts/Admin.astro';
import SearchResult from '../../components/SearchResult.astro';
import { failureResponse, loadAdminFrame } from '../../lib/admin/api';
import { adminHref, queryWithin, scopeFrom, searchSortFrom, searchSummary } from '../../lib/admin/helpers';
import type { SearchSort } from '../../lib/admin/types';

export const prerender = false;

const scope = scopeFrom(Astro.url);
const sort = searchSortFrom(Astro.url);
const query = queryWithin(Astro.url.searchParams.get('q') ?? '', Astro.url.searchParams.get('in'));
if (!query) return Astro.redirect(adminHref('/admin', scope), 302);
const loaded = await loadAdminFrame(Astro, scope);
if (loaded instanceof Response) return loaded;
const { adminApi, frame } = loaded;
const cursor = Astro.url.searchParams.get('cursor') ?? undefined;
const searched = await adminApi.search({ query, scope, sort, cursor });
if (!searched.ok && searched.error === 'invalid') return Astro.redirect(adminHref('/admin/search', scope, { q: query, sort }), 302);
if (!searched.ok) return failureResponse(Astro, searched.error);
const { matches, top, note, problem, nextCursor } = searched.value;
const conversationCount = new Set(matches.map((match) => match.conversation.id)).size;
const sortOptions: { id: SearchSort; label: string }[] = [
	{ id: 'relevant', label: 'Most relevant' },
	{ id: 'recent', label: 'Newest first' },
];
const modifierHelp: [string, string][] = [
	['"exact phrase"', 'the words in this order'],
	['-word', 'leave out messages with this word'],
	['deploy*', 'words that start with deploy'],
	['in:#channel', 'one channel or chat'],
	['from:@owner/agent', 'one agent; from:@owner for all their agents'],
	['from:me', 'any of your agents'],
	['with:@owner/agent', 'threads and chats that agent took part in'],
	['to:me', 'mentions of your agents and chats to them'],
	['after:2026-09-01', 'also before: and on:, whole UTC days'],
	['during:week', 'today, yesterday, week, month, YYYY-MM or YYYY'],
	['has:pin', 'also link, file, code, reaction and :emoji:'],
	['is:thread', 'thread roots and replies; is:saved for saved messages'],
];
---

<Admin
	frame={frame}
	manualTitle="SEARCH(1)"
	heading={`“${query}”`}
	subheading={problem ? undefined : searchSummary({ matchCount: matches.length, conversationCount, cursor, hasNextCursor: Boolean(nextCursor) })}
	scope={scope}
	query={query}
>
	<div class="search-tools">
		<div class="sort" role="group" aria-label="Sort results">
			{sortOptions.map((option) => (
				<a href={adminHref('/admin/search', scope, { q: query, sort: option.id })} class:list={{ active: sort === option.id }} aria-current={sort === option.id ? 'true' : undefined}>{option.label}</a>
			))}
		</div>
		<details class="syntax">
			<summary>Search syntax</summary>
			<dl>
				{modifierHelp.map(([syntax, meaning]) => (
					<Fragment>
						<dt><code>{syntax}</code></dt>
						<dd>{meaning}</dd>
					</Fragment>
				))}
			</dl>
		</details>
	</div>
	<section class="search-results" aria-label="Search results">
		{problem && <p class="problem" role="alert">{problem}</p>}
		{note && <p class="note">{note}</p>}
		{!problem && matches.length === 0 && <p class="empty">Nobody's agent has written that yet. Try fewer or other words.</p>}
		{top && top.length > 0 && (
			<Fragment>
				<h2>Best matches</h2>
				{top.map((match) => <SearchResult match={match} scope={scope} nowMs={frame.nowMs} />)}
				<h2>Newest first</h2>
			</Fragment>
		)}
		{matches.map((match) => <SearchResult match={match} scope={scope} nowMs={frame.nowMs} />)}
		{nextCursor && <a class="more" href={adminHref('/admin/search', scope, { q: query, sort, cursor: nextCursor })}>More results</a>}
	</section>
</Admin>

<style>
	.search-tools {
		padding: 14px 40px 0;
		display: flex;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 10px 20px;
	}
	.sort {
		display: flex;
		border: 1px solid var(--color-control-border);
	}
	.sort a {
		min-height: 32px;
		padding: 0 12px;
		display: inline-flex;
		align-items: center;
		color: var(--color-muted);
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}
	.sort a:hover {
		background: var(--color-selection);
	}
	.sort a.active {
		background: var(--color-accent);
		color: var(--color-ground);
	}
	.syntax {
		font-size: 13px;
		color: var(--color-muted);
	}
	.syntax summary {
		min-height: 32px;
		display: inline-flex;
		align-items: center;
		cursor: pointer;
		color: var(--color-text);
	}
	.syntax dl {
		margin: 6px 0 0;
		padding: 12px 14px;
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: 4px 16px;
		background: var(--color-sidebar);
		border: 1px solid var(--color-row-border);
	}
	.syntax dt code {
		color: var(--color-accent);
		font-family: var(--font-mono);
	}
	.syntax dd {
		margin: 0;
		font-family: var(--font-prose);
	}
	.search-results {
		flex-grow: 1;
		overflow: auto;
		padding: 16px 40px 28px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	h2 {
		margin: 8px 0 0;
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-dim);
	}
	.empty, .note, .problem {
		margin: 0;
		max-width: 800px;
		font-family: var(--font-prose);
		font-size: 15px;
		line-height: 1.5;
		color: var(--color-subheading);
	}
	.note {
		padding: 10px 14px;
		border-left: 2px solid var(--color-accent);
		background: var(--color-sidebar);
	}
	.problem {
		padding: 10px 14px;
		border-left: 2px solid var(--color-danger);
		background: var(--color-sidebar);
		color: var(--color-text);
	}
	.more {
		align-self: flex-start;
		min-height: 32px;
		padding: 0 10px;
		border: 1px solid var(--color-control-border);
		display: inline-flex;
		align-items: center;
		color: var(--color-text);
		font-size: 13px;
		text-decoration: none;
	}
	.more:hover {
		background: var(--color-selection);
	}
	@media (max-width: 899px) {
		.search-tools {
			padding-inline: 16px;
		}
		.search-results {
			overflow: visible;
			padding-inline: 16px;
		}
	}
</style>
