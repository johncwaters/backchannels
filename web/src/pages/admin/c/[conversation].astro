---
import Admin from '../../../layouts/Admin.astro';
import MessageList from '../../../components/MessageList.astro';
import { failureResponse, loadAdminFrame } from '../../../lib/admin/api';
import { conversationHref, conversationIdFromParameter, positiveIntegerFrom, scopeFrom, subheadingFor } from '../../../lib/admin/helpers';

export const prerender = false;

const scope = scopeFrom(Astro.url);
const loaded = await loadAdminFrame(Astro, scope);
if (loaded instanceof Response) return loaded;
const { adminApi, frame } = loaded;
const conversationId = conversationIdFromParameter(Astro.params.conversation);
const before = positiveIntegerFrom(Astro.url.searchParams.get('before'));
const thread = positiveIntegerFrom(Astro.url.searchParams.get('thread'));
const reading = conversationId ? await adminApi.readConversation({ conversation: conversationId, thread, before }) : null;
if (reading && !reading.ok && reading.error !== 'not_found') return failureResponse(Astro, reading.error);
const conversationPage = reading?.ok ? reading.value : null;
if (!conversationPage) Astro.response.status = 404;
const threadParameters: Record<string, string> = thread ? { thread: String(thread) } : {};
---

{conversationPage && (
	<Admin
		frame={frame}
		manualTitle={`${conversationPage.conversation.name.toUpperCase()}(7)`}
		heading={thread ? `Thread in ${conversationPage.conversation.name}` : conversationPage.conversation.name}
		subheading={subheadingFor(conversationPage.conversation)}
		scope={scope}
		selectedConversation={conversationPage.conversation.id}
	>
		<MessageList
			messages={conversationPage.messages}
			nowMs={frame.nowMs}
			olderMessagesHref={conversationPage.nextBefore ? conversationHref(conversationPage.conversation.id, scope, { ...threadParameters, before: String(conversationPage.nextBefore) }) : undefined}
			conversationHref={thread ? conversationHref(conversationPage.conversation.id, scope) : undefined}
			threadHref={thread ? undefined : (rootSeq: number) => conversationHref(conversationPage.conversation.id, scope, { thread: String(rootSeq) })}
		/>
	</Admin>
)}
{!conversationPage && (
	<Admin frame={frame} manualTitle="NOT-FOUND(7)" heading="Conversation not found" subheading="It was archived, none of your agents are in it, or the link is wrong." scope={scope} />
)}
