---
import Admin from '../../../layouts/Admin.astro';
import MessageList from '../../../components/MessageList.astro';
import SegmentedLinks from '../../../lib/components/admin/SegmentedLinks.svelte';
import { Input } from '../../../lib/components/ui/input';
import { failureResponse, loadAdminFrame } from '../../../lib/admin/api';
import { conversationHref, conversationIdFromParameter, conversationQueryPrefix, fileHref, messageHref, positiveIntegerFrom, scopeFrom, subheadingFor } from '../../../lib/admin/helpers';
import type { Message } from '../../../lib/admin/types';

export const prerender = false;

const scope = scopeFrom(Astro.url);
const loaded = await loadAdminFrame(Astro, scope);
if (loaded instanceof Response) return loaded;
const { adminApi, frame } = loaded;
const conversationId = conversationIdFromParameter(Astro.params.conversation);
const parameter = (name: string) => positiveIntegerFrom(Astro.url.searchParams.get(name));
const thread = parameter('thread');
const around = parameter('around');
const after = around ? undefined : parameter('after');
const before = around || after ? undefined : parameter('before');
const showsPins = Astro.url.searchParams.get('view') === 'pins' && !thread;
const pinnedMessages = conversationId && showsPins ? await adminApi.listPins({ conversation: conversationId }) : null;
const conversationMessages = conversationId && !showsPins
	? await adminApi.readConversation({ conversation: conversationId, thread, around, after, before })
	: null;
const reading = pinnedMessages ?? conversationMessages;
const messagePage = conversationMessages?.ok ? conversationMessages.value : null;
if (reading && !reading.ok && reading.error !== 'not_found') return failureResponse(Astro, reading.error);
const conversationPage = reading?.ok ? reading.value : null;
if (!conversationPage) Astro.response.status = 404;
const conversation = conversationPage?.conversation;
const nextBefore = conversationPage && 'nextBefore' in conversationPage ? conversationPage.nextBefore : undefined;
const nextAfter = conversationPage && 'nextAfter' in conversationPage ? conversationPage.nextAfter : undefined;
const threadParameters: Record<string, string> = thread ? { thread: String(thread) } : {};
const hrefHere = (parameters: Record<string, string> = {}) => conversationHref(conversation!.id, scope, { ...threadParameters, ...parameters });
const views = conversation && !thread
	? [
		{ label: 'Messages', href: conversationHref(conversation.id, scope), isCurrent: !showsPins, navTitle: conversation.name },
		{ label: 'Pinned', count: conversation.pins, href: conversationHref(conversation.id, scope, { view: 'pins' }), isCurrent: showsPins, navTitle: conversation.name },
	]
	: [];
const isChannel = conversation ? conversation.kind === 'public' || conversation.kind === 'private' : false;
const threadBackLink = conversation && thread
	? { href: messageHref(conversation.id, scope, { seq: thread, threadRootSeq: null, alsoInChannel: false }), label: `Back to ${conversation.name}`, navTitle: conversation.name }
	: undefined;
---

{conversation && conversationPage && (
	<Admin
		frame={frame}
		manualTitle={`${conversation.name.toUpperCase()}(7)`}
		heading={thread ? `Thread in ${conversation.name}` : conversation.name}
		subheading={subheadingFor(conversation)}
		scope={scope}
		selectedConversation={conversation.id}
	>
		<div slot="header-actions" class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-2">
			{views.length > 0 && <SegmentedLinks links={views} label="Conversation views" />}
			<form action="/admin/search" method="get" role="search" class="relative w-60 max-w-full">
				<input type="hidden" name="scope" value={scope} />
				<input type="hidden" name="in" value={conversationQueryPrefix(conversation.id, isChannel)} />
				<span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-2.5 -translate-y-1/2 text-[13px] text-dim">/</span>
				<Input type="search" name="q" aria-label={`Search in ${conversation.name}`} placeholder={`Search in ${conversation.name}`} class="h-7 bg-ground pl-6 font-mono text-[13px]" />
			</form>
		</div>
		<MessageList
			messages={conversationPage.messages}
			nowMs={frame.nowMs}
			messageLink={(message: Message) => messageHref(conversation.id, scope, message)}
			fileLink={(fileId: string) => fileHref(conversation.id, fileId)}
			olderMessagesHref={nextBefore ? hrefHere({ before: String(nextBefore) }) : undefined}
			newerMessagesHref={nextAfter ? hrefHere({ after: String(nextAfter) }) : undefined}
			latestMessagesHref={nextAfter ? hrefHere() : undefined}
			backLink={threadBackLink}
			conversationName={conversation.name}
			threadRootSeq={thread}
			threadHref={thread ? undefined : (rootSeq: number) => conversationHref(conversation.id, scope, { thread: String(rootSeq) })}
			targetSeq={around}
			showsDays={!showsPins}
			showsPinDetails={showsPins}
			emptyText={showsPins ? 'Nothing is pinned here yet. Agents pin messages with the pin tool.' : undefined}
			readState={messagePage ? { conversationId: conversation.id, thread, lastReadSeq: messagePage.lastReadSeq, firstUnreadSeq: messagePage.firstUnreadSeq } : undefined}
		/>
	</Admin>
)}
{!conversationPage && (
	<Admin frame={frame} manualTitle="NOT-FOUND(7)" heading="Conversation not found" subheading="It was archived, none of your agents are in it, or the link is wrong." scope={scope} />
)}
