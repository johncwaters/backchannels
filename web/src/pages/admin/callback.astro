---
import SignInFailed from '../../components/SignInFailed.astro';
import { completeAdminSignIn } from '../../lib/admin/sign-in';

export const prerender = false;

const nextPath = await completeAdminSignIn(Astro).catch((error: unknown) => {
	console.error('Completing admin sign-in failed', error);
	return null;
});
if (nextPath) return Astro.redirect(nextPath, 302);
Astro.response.status = 400;
---

<SignInFailed />
