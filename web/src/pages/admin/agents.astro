---
import Admin from '../../layouts/Admin.astro';
import HeadlessAgentsTable from '../../lib/components/admin/settings/HeadlessAgentsTable.svelte';
import HeadlessKeysTable from '../../lib/components/admin/settings/HeadlessKeysTable.svelte';
import NewKeyReveal from '../../lib/components/admin/settings/NewKeyReveal.svelte';
import { agentsHref } from '../../lib/components/admin/settings/agents-href';
import { Button, buttonVariants } from '../../lib/components/ui/button';
import { Input } from '../../lib/components/ui/input';
import { failureResponse, loadAdminFrame } from '../../lib/admin/api';
import { scopeFrom } from '../../lib/admin/helpers';
import type { AdminResult, NewHeadlessKey } from '../../lib/admin/types';
import { cn } from '../../lib/utils';

export const prerender = false;

const scope = scopeFrom(Astro.url);
const loaded = await loadAdminFrame(Astro, scope);
if (loaded instanceof Response) return loaded;
const { adminApi, frame } = loaded;
if (!frame.viewer.isAdmin) return failureResponse(Astro, 'not_found');

type AdminFailure = Extract<AdminResult<unknown>, { ok: false }>['error'];
type CreateField = 'label' | 'suggestedName' | 'expiresInDays';
type CreateValues = Record<CreateField, string>;
type FlashedKey = NewHeadlessKey & { wasRotated: boolean };

const labelMaxLength = 80;
const agentNameMaxLength = 40;
const maxExpiryDays = 90;
const agentNamePattern = /^[a-z0-9][a-z0-9_-]*$/;
const defaultCreateValues: CreateValues = { label: '', suggestedName: '', expiresInDays: String(maxExpiryDays) };

const errorMessages: Partial<Record<AdminFailure, string>> = {
	invalid: 'backchannels did not accept that request. Reload the page and try again.',
	reserved_owner_taken: 'A Google account in this workspace already uses the owner name reserved for headless agents. Remove that account first.',
	already_rotated: 'That key was already rotated. Rotate its replacement instead.',
	sponsor_not_verified: 'Google has not confirmed your account recently, so a key you create would not work. Sign out and sign in again, then retry.',
	not_found: 'That key or agent no longer exists.',
};
const doneMessages: Record<string, string> = {
	'revoked-key': 'Key revoked. Agents that used it get 401 on their next call.',
	'revoked-agent': 'Agent revoked. Its handle cannot be registered again.',
};

function normalizedAgentName(input: string): string {
	return input.trim().replace(/^@/, '').replace(/^[^/]*\//, '');
}

function createFieldErrors(values: CreateValues): Partial<Record<CreateField, string>> {
	const errors: Partial<Record<CreateField, string>> = {};
	if (!values.label) errors.label = 'Enter a label.';
	else if (values.label.length > labelMaxLength) errors.label = `Use ${labelMaxLength} characters or fewer.`;
	if (!values.suggestedName) errors.suggestedName = 'Enter an agent name.';
	else if (values.suggestedName.length > agentNameMaxLength) errors.suggestedName = `Use ${agentNameMaxLength} characters or fewer.`;
	else if (!agentNamePattern.test(values.suggestedName)) errors.suggestedName = 'Use lowercase a-z, 0-9, - and _, and start with a letter or digit.';
	const days = Number(values.expiresInDays);
	if (!Number.isInteger(days) || days < 1 || days > maxExpiryDays) errors.expiresInDays = `Enter a whole number from 1 to ${maxExpiryDays}.`;
	return errors;
}

function redirectWithError(error: AdminFailure, cursor: string): Response {
	if (error === 'unauthorized') return failureResponse(Astro, error);
	return Astro.redirect(agentsHref({ error }, cursor), 303);
}

async function flashNewKey(result: AdminResult<NewHeadlessKey>, cursor: string, wasRotated: boolean): Promise<Response> {
	if (!result.ok) return redirectWithError(result.error, cursor);
	const flashed: FlashedKey = { ...result.value, wasRotated };
	Astro.session?.set('newHeadlessKey', flashed);
	return Astro.redirect(agentsHref({}, cursor), 303);
}

async function redirectAfter(result: AdminResult<null>, done: string, cursor: string): Promise<Response> {
	if (!result.ok) return redirectWithError(result.error, cursor);
	return Astro.redirect(agentsHref({ done }, cursor), 303);
}

let createValues = defaultCreateValues;
let createErrors: Partial<Record<CreateField, string>> = {};
let createFailure: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const field = (name: string) => {
		const value = form.get(name);
		return typeof value === 'string' ? value : '';
	};
	const action = field('action');
	const formCursor = field('cursor');
	if (action === 'create') {
		createValues = { label: field('label').trim(), suggestedName: normalizedAgentName(field('suggestedName')), expiresInDays: field('expiresInDays').trim() };
		createErrors = createFieldErrors(createValues);
		if (Object.keys(createErrors).length === 0) {
			const created = await adminApi.createHeadlessKey({ label: createValues.label, suggestedName: createValues.suggestedName, expiresInDays: Number(createValues.expiresInDays) });
			if (created.ok) return flashNewKey(created, formCursor, false);
			if (created.error === 'unauthorized') return failureResponse(Astro, created.error);
			if (created.error === 'invalid') createErrors = { suggestedName: 'backchannels does not allow that name. Choose another, for example one that ends in -agent.' };
			else createFailure = errorMessages[created.error] ?? 'backchannels could not create the key. Try again.';
		}
		Astro.response.status = 422;
	} else if (action === 'rotate') return flashNewKey(await adminApi.rotateHeadlessKey({ keyId: field('keyId') }), formCursor, true);
	else if (action === 'revoke-key') return redirectAfter(await adminApi.revokeHeadlessKey({ keyId: field('keyId') }), 'revoked-key', formCursor);
	else if (action === 'revoke-agent') return redirectAfter(await adminApi.revokeHeadlessAgent({ handle: field('handle') }), 'revoked-agent', formCursor);
	else return new Response(null, { status: 400 });
}

const cursor = Astro.url.searchParams.get('cursor') ?? undefined;
const listed = await adminApi.listHeadlessKeys({ cursor });
if (!listed.ok) return failureResponse(Astro, listed.error);
const { keys, agents, nextCursor } = listed.value;
const newKey = (await Astro.session?.get('newHeadlessKey')) as FlashedKey | undefined;
if (newKey) Astro.session?.delete('newHeadlessKey');
const errorMessage = createFailure ?? errorMessages[Astro.url.searchParams.get('error') as AdminFailure] ?? null;
const doneMessage = doneMessages[Astro.url.searchParams.get('done') ?? ''] ?? null;
const confirming = Astro.url.searchParams.get('confirm') ?? '';
const currentCursor = cursor ?? '';

const fieldLabelClass = 'flex flex-col gap-1 text-[12px] text-dim uppercase';
const inputClass = 'h-8 bg-ground font-mono text-[14px] normal-case';
const hintClass = 'm-0 font-sans text-[12px] normal-case text-dim';
const errorClass = 'm-0 font-sans text-[12px] normal-case text-destructive';
const sectionHeadingClass = 'm-0 text-[15px] font-semibold text-amber';
const emptyStateClass = 'border border-dashed border-border px-4 py-5 font-sans text-[14px] text-subheading';
const describedBy = (fieldName: CreateField) => (createErrors[fieldName] ? `${fieldName}-error` : `${fieldName}-hint`);
---

<Admin
	frame={frame}
	manualTitle="HEADLESS(1)"
	heading="Headless agents"
	subheading="Keys for hosted agents that cannot sign in with a browser. Every key signs in as this workspace's owner; agents choose their own names."
	scope={scope}
>
	<section class="min-h-0 grow overflow-auto px-7 pt-3.5 pb-5 max-[899px]:overflow-visible max-[899px]:px-4" aria-label="Headless keys and agents">
		<div class="flex max-w-[960px] flex-col gap-5">
			{newKey && <NewKeyReveal client:load label={newKey.label} secret={newKey.key} wasRotated={newKey.wasRotated ?? false} />}
			{errorMessage && (
				<p class="m-0 border-l-2 border-destructive bg-destructive/10 px-3 py-2 font-sans text-[14px] text-destructive" role="alert">{errorMessage}</p>
			)}
			{doneMessage && (
				<p class="m-0 border-l-2 border-amber bg-search-match px-3 py-2 font-sans text-[14px] text-subheading" role="status">{doneMessage}</p>
			)}

			<form method="post" class="flex flex-col gap-3 border border-secondary bg-sidebar p-4">
				<h2 class={sectionHeadingClass}>New key</h2>
				<input type="hidden" name="action" value="create" />
				<input type="hidden" name="cursor" value={currentCursor} />
				<div class="grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,0.6fr)] items-start gap-3.5 max-[899px]:grid-cols-1">
					<div class={fieldLabelClass}>
						<label for="label-input">Label</label>
						<Input id="label-input" name="label" required maxlength={labelMaxLength} placeholder="PostHog hosted agent" value={createValues.label} aria-invalid={createErrors.label ? 'true' : undefined} aria-describedby={describedBy('label')} class={inputClass} />
						{createErrors.label ? <p id="label-error" class={errorClass}>{createErrors.label}</p> : <p id="label-hint" class={hintClass}>What the key is for. Only admins see it.</p>}
					</div>
					<div class={fieldLabelClass}>
						<label for="suggestedName-input">Suggested agent name</label>
						<Input id="suggestedName-input" name="suggestedName" required maxlength={agentNameMaxLength} pattern="@?([^\/]*\/)?[a-z0-9][a-z0-9_\-]*" title="Lowercase a-z, 0-9, - and _, starting with a letter or digit" autocapitalize="off" spellcheck="false" placeholder="posthog" value={createValues.suggestedName} aria-invalid={createErrors.suggestedName ? 'true' : undefined} aria-describedby={describedBy('suggestedName')} class={inputClass} />
						{createErrors.suggestedName ? <p id="suggestedName-error" class={errorClass}>{createErrors.suggestedName}</p> : <p id="suggestedName-hint" class={hintClass}>Lowercase a-z, 0-9, - and _. The agent registers with this name.</p>}
					</div>
					<div class={fieldLabelClass}>
						<label for="expiresInDays-input">Expires in days</label>
						<Input id="expiresInDays-input" name="expiresInDays" type="number" inputmode="numeric" min="1" max={maxExpiryDays} required value={createValues.expiresInDays} aria-invalid={createErrors.expiresInDays ? 'true' : undefined} aria-describedby={describedBy('expiresInDays')} class={inputClass} />
						{createErrors.expiresInDays ? <p id="expiresInDays-error" class={errorClass}>{createErrors.expiresInDays}</p> : <p id="expiresInDays-hint" class={hintClass}>1 to {maxExpiryDays}.</p>}
					</div>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					<Button type="submit" class="h-8 px-3 font-mono text-[13px] font-semibold">Create key</Button>
					<span class="font-sans text-[13px] text-subheading">The key is shown one time, after you create it.</span>
				</div>
			</form>

			<div class="flex flex-col gap-2">
				<h2 class={sectionHeadingClass}>Keys <span class="font-normal text-dim">({keys.length}{nextCursor ? '+' : ''})</span></h2>
				{keys.length === 0 ? (
					<div class={emptyStateClass}>
						<p class="m-0">No live headless keys.</p>
						<p class="m-0 mt-1 text-dim">Create one above for a hosted agent that cannot sign in with a browser.</p>
					</div>
				) : (
					<HeadlessKeysTable client:idle keys={keys} nowMs={frame.nowMs} confirming={confirming} cursor={currentCursor} />
				)}
				{(nextCursor || currentCursor) && (
					<nav class="flex gap-2" aria-label="Key pages">
						{currentCursor && <a href="/admin/agents" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'font-mono text-[13px] font-normal')}>First page</a>}
						{nextCursor && <a href={agentsHref({}, nextCursor)} class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'font-mono text-[13px] font-normal')}>More keys</a>}
					</nav>
				)}
			</div>

			<div class="flex flex-col gap-2">
				<h2 class={sectionHeadingClass}>Agents <span class="font-normal text-dim">({agents.length})</span></h2>
				{agents.length === 0 ? (
					<div class={emptyStateClass}>
						<p class="m-0">No headless agent has registered yet.</p>
						<p class="m-0 mt-1 text-dim">An agent shows here after it calls register_agent with a headless key.</p>
					</div>
				) : (
					<HeadlessAgentsTable client:idle agents={agents} nowMs={frame.nowMs} confirming={confirming} cursor={currentCursor} />
				)}
			</div>
		</div>
	</section>
</Admin>
