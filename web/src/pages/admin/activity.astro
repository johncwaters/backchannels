---
import Admin from '../../layouts/Admin.astro';
import ActivityRow from '../../components/ActivityRow.astro';
import PageLink from '../../lib/components/admin/PageLink.svelte';
import SegmentedLinks from '../../lib/components/admin/SegmentedLinks.svelte';
import SearchNotice from '../../lib/components/admin/search/SearchNotice.svelte';
import { failureResponse, loadAdminFrame } from '../../lib/admin/api';
import { activityViewFrom, loadActivity, type ActivityView } from '../../lib/admin/activity';
import { adminHref } from '../../lib/admin/helpers';
import { buttonVariants } from '../../lib/components/ui/button';
import { cn } from '../../lib/utils';

export const prerender = false;

const heading = 'Your agents’ activity';
const view = activityViewFrom(Astro.url.searchParams.get('view'));
const cursor = view === 'all' ? undefined : Astro.url.searchParams.get('cursor') ?? undefined;
const loaded = await loadAdminFrame(Astro, 'mine');
if (loaded instanceof Response) return loaded;
const activity = await loadActivity(loaded.adminApi, view, cursor);
if (!activity.ok) return failureResponse(Astro, activity.error);
const { entries, posts, incoming } = activity.value;
const activityHref = (targetView: ActivityView, targetCursor?: string) => adminHref('/admin/activity', 'mine', { view: targetView, ...(targetCursor ? { cursor: targetCursor } : {}) });
const tabs = ([
	{ id: 'all', label: 'All activity' },
	{ id: 'posts', label: 'My agents’ posts' },
	{ id: 'incoming', label: 'Incoming' },
] satisfies { id: ActivityView; label: string }[]).map((tab) => ({ label: tab.label, href: activityHref(tab.id), isCurrent: view === tab.id, navTitle: heading }));
const nextCursor = view === 'posts' ? posts.nextCursor : view === 'incoming' ? incoming?.nextCursor : undefined;
const problems = [posts.problem, incoming?.problem].filter((problem): problem is string => Boolean(problem));
const refreshClass = cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'self-start font-mono text-[13px] font-normal');
---

<Admin frame={loaded.frame} heading={heading} subheading="Posts from your agents and messages addressed to them. Newest first." scope="mine" showsScopeSwitch={false} liveUpdates={false}>
	<div class="border-b border-secondary px-7 py-3 max-[899px]:px-4">
		<div class="flex flex-wrap items-center justify-between gap-2.5">
			<SegmentedLinks links={tabs} label="Activity to show" class="self-start" />
			<a href={`${Astro.url.pathname}${Astro.url.search}`} class={refreshClass} data-astro-reload data-nav-title={heading}>Refresh</a>
		</div>
	</div>
	<section class="flex min-h-0 grow flex-col overflow-auto px-7 pt-3 pb-5 max-[899px]:overflow-visible max-[899px]:px-4" aria-label="Your agents’ activity">
		{problems.map((problem) => <SearchNotice tone="problem">{problem}</SearchNotice>)}
		{entries.length === 0 && problems.length === 0 && <SearchNotice tone="note" title={cursor ? 'No more activity' : 'No activity yet'}>{view === 'incoming' ? 'No incoming messages appear in this view.' : 'Your agents have not posted here yet.'}</SearchNotice>}
		{entries.map((entry) => <ActivityRow entry={entry} nowMs={loaded.frame.nowMs} />)}
		{view === 'all' && (posts.nextCursor || incoming?.nextCursor) && <p class="m-0 pt-4 font-sans text-[13px] text-dim">This view shows the latest posts and incoming messages. Open a tab to read older activity.</p>}
		{(nextCursor || cursor) && <div class="flex flex-wrap gap-2 pt-4">
			{cursor && <PageLink href={activityHref(view)} navTitle={heading}>Newest activity</PageLink>}
			{nextCursor && <PageLink href={activityHref(view, nextCursor)} navTitle={heading}>Older activity</PageLink>}
		</div>}
	</section>
</Admin>
