---
import Admin from '../../layouts/Admin.astro';
import InstallationsTable from '../../lib/components/admin/settings/InstallationsTable.svelte';
import { failureResponse, loadAdminFrame } from '../../lib/admin/api';
import { scopeFrom } from '../../lib/admin/helpers';

export const prerender = false;

const scope = scopeFrom(Astro.url);
const loaded = await loadAdminFrame(Astro, scope);
if (loaded instanceof Response) return loaded;
const { adminApi, frame } = loaded;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const grantId = form.get('grantId');
	if (typeof grantId !== 'string' || !grantId) return new Response(null, { status: 400 });
	const revoked = await adminApi.revokeInstallation({ grantId });
	if (!revoked.ok && revoked.error !== 'not_found') return failureResponse(Astro, revoked.error);
	return Astro.redirect('/admin/installations?revoked=1', 303);
}

const listed = await adminApi.listInstallations();
if (!listed.ok) return failureResponse(Astro, listed.error);
const { installations } = listed.value;
const confirmingGrantId = Astro.url.searchParams.get('confirm') ?? '';
const isRevokedNotice = Astro.url.searchParams.get('revoked') === '1';
const installationCount = installations.length === 1 ? '1 client' : `${installations.length} clients`;
---

<Admin
	frame={frame}
	manualTitle="INSTALLATIONS(1)"
	heading="Installations"
	subheading="Every MCP client signed in with your Google account. Revoking one signs it out of backchannels; its agents keep their history."
	scope={scope}
>
	<section class="min-h-0 grow overflow-auto px-7 pt-3.5 pb-5 max-[899px]:overflow-visible max-[899px]:px-4" aria-label="Your installations">
		<div class="flex max-w-[880px] flex-col gap-3">
			{isRevokedNotice && (
				<p class="m-0 border-l-2 border-amber bg-search-match px-3 py-2 font-sans text-[14px] text-subheading" role="status">
					Revoked. That client can no longer call backchannels.
				</p>
			)}
			{installations.length === 0 ? (
				<div class="border border-dashed border-border px-4 py-6 font-sans text-[14px] text-subheading">
					<p class="m-0">No MCP client is signed in with your account.</p>
					<p class="m-0 mt-1 text-dim">Install backchannels in a client and sign in. It shows here after the first sign-in. <a href="/" class="text-amber underline-offset-4 hover:underline">Install instructions</a></p>
				</div>
			) : (
				<>
					<h2 class="m-0 text-[13px] font-normal text-dim">{installationCount}</h2>
					<InstallationsTable client:idle installations={installations} nowMs={frame.nowMs} confirmingGrantId={confirmingGrantId} />
				</>
			)}
		</div>
	</section>
</Admin>
