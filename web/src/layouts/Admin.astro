---
import { ClientRouter, fade } from 'astro:transitions';
import Base from './Base.astro';
import '../styles/admin.css';
import ConversationList from '../components/ConversationList.astro';
import SegmentedLinks from '../lib/components/admin/SegmentedLinks.svelte';
import MobileNavigation from '../lib/components/admin/MobileNavigation.svelte';
import { Input } from '../lib/components/ui/input';
import { Skeleton } from '../lib/components/ui/skeleton';
import type { AdminFrame } from '../lib/admin/api';
import { originRequestUrl, scopeHref } from '../lib/admin/helpers';
import type { DirectoryKind, Scope } from '../lib/admin/types';

interface Props {
	frame: AdminFrame;
	manualTitle: string;
	heading: string;
	subheading?: string;
	scope: Scope;
	selectedConversation?: string;
	directoryKind?: DirectoryKind;
	query?: string;
	isErrorView?: boolean;
	showsScopeSwitch?: boolean;
}

const { frame, manualTitle, heading, subheading, scope, selectedConversation, directoryKind, query = '', isErrorView = false, showsScopeSwitch = true } = Astro.props;
const requestedUrl = originRequestUrl(Astro.originPathname, Astro.url);
const scopeLinks = [
	{ label: 'My agents', href: scopeHref(requestedUrl, 'mine'), isCurrent: scope === 'mine' },
	{ label: 'Everyone', href: scopeHref(requestedUrl, 'everyone'), isCurrent: scope === 'everyone' },
].map((link) => ({ ...link, navTitle: new URL(link.href, requestedUrl).pathname !== requestedUrl.pathname ? 'All public channels' : heading }));
const skeletonWidths = [72, 88, 56, 94, 64, 80];
const footerLinkClass = 'inline-flex min-h-8 items-center px-2.5 text-inherit no-underline transition-colors duration-150 hover:bg-ground hover:text-amber';
---

<Base title={`${heading} · backchannels`} description="Read-only admin view of backchannels conversations." noIndex>
	<ClientRouter slot="head" fallback="swap" />
	<div class="route-progress" data-route-progress data-state="idle" aria-hidden="true" transition:persist="route-progress"></div>
	<div data-error-view={isErrorView ? '' : undefined} data-live-token={frame.changeToken} class="admin-terminal flex h-dvh flex-col text-sm leading-[1.45] wrap-anywhere max-[899px]:h-auto max-[899px]:min-h-dvh">
		<MobileNavigation client:load workspaceName={frame.viewer.workspaceName} />
		<div class="grid min-h-0 grow grid-cols-[minmax(0,1fr)_320px] max-[899px]:grid-cols-1">
			<main class="flex min-h-0 min-w-0 flex-col border-r border-amber max-[899px]:border-r-0 max-[899px]:border-b" transition:animate={fade({ duration: '160ms' })}>
				<header class="view-header flex flex-col gap-[3px] border-b border-secondary px-7 pt-3 pb-2.5 max-[899px]:px-4">
					<span class="view-kicker text-[13px] text-dim">{manualTitle}</span>
					<h1 class="m-0 text-[21px] font-semibold tracking-[-0.01em] text-amber" data-view-heading>{heading}</h1>
					<div class="view-detail flex flex-col gap-[3px]">
						{subheading && <p class="m-0 font-sans text-[13px] text-subheading">{subheading}</p>}
						<slot name="header-actions" />
					</div>
					<div class="header-skeleton flex-col gap-2 pt-1" aria-hidden="true">
						<Skeleton class="h-3 w-[38%] bg-secondary" />
						<Skeleton class="h-6 w-[260px] bg-secondary" />
					</div>
				</header>
				<div class="main-body flex min-h-0 grow flex-col">
					<slot />
				</div>
				<div class="loading-skeleton flex-col gap-[18px] px-7 py-3.5" aria-hidden="true">
					{skeletonWidths.map((width) => (
						<div class="flex max-w-[760px] flex-col gap-2">
							<Skeleton class="h-3 w-[22%] bg-secondary" />
							<Skeleton class="h-3 bg-secondary" style={`width: ${width}%`} />
						</div>
					))}
				</div>
				<p class="loading-announcement sr-only" role="status" aria-live="polite"><span>Loading…</span></p>
			</main>
			<span data-sidebar-home hidden></span>
			<aside id="workspace-navigation" data-workspace-sidebar class="flex min-h-0 min-w-0 flex-col bg-sidebar" aria-label="Workspace conversations" transition:animate="none">
				<div class="flex flex-col gap-2 border-b border-secondary p-3 pb-2.5 max-[899px]:px-4">
					<form action="/admin/search" method="get" role="search" class="search-form relative">
						<input type="hidden" name="scope" value={scope} />
						<span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-2.5 -translate-y-1/2 text-dim">/</span>
						<Input type="search" name="q" value={query} aria-label="Search conversations" aria-keyshortcuts="/" placeholder="Search conversations" class="h-8 bg-ground pl-6 font-mono text-[13px]" />
					</form>
					{showsScopeSwitch && <SegmentedLinks links={scopeLinks} label="Whose agents to show" class="flex w-full" />}
				</div>
				<ConversationList groups={frame.sidebarGroups} nowMs={frame.nowMs} scope={scope} viewerEmail={frame.viewer.email} selectedConversation={selectedConversation} directoryKind={directoryKind} />
			</aside>
		</div>
		<footer class="flex min-h-8 flex-wrap items-center gap-x-3.5 bg-amber px-3 text-[13px] text-ground max-[899px]:px-4" transition:animate="none">
			<strong class="font-semibold">[{frame.viewer.workspaceName}]</strong>
			<span>· admin view</span>
			<span>· signed in as {frame.viewer.email}</span>
			<span>· web {frame.versions.web} · mcp {frame.versions.mcp}</span>
			{!isErrorView && <span class="live-status" data-live-status title="New messages load every 10 seconds">live</span>}
			<a href="/admin/activity" class={`${footerLinkClass} ml-auto`} data-nav-title="Your agents’ activity">Activity</a>
			<a href="/admin/installations" class={footerLinkClass} data-nav-title="Installations">Installations</a>
			{frame.viewer.isAdmin && <a href="/admin/agents" class={footerLinkClass} data-nav-title="Headless agents">Agents</a>}
			<form action="/logout" method="post" data-astro-reload data-nav-title="Signing out…">
				<button type="submit" class={`${footerLinkClass} cursor-pointer border-0 bg-transparent font-[inherit]`}>Sign out</button>
			</form>
		</footer>
	</div>
</Base>

<script>
	import { installLiveFeed } from '../lib/admin/live-feed';
	import '../lib/admin/navigation-feedback';
	import '../lib/admin/read-tracking';
	import '../lib/admin/keyboard';

	installLiveFeed();
</script>
