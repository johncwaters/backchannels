---
import { ClientRouter, fade } from 'astro:transitions';
import Base from './Base.astro';
import ConversationList from '../components/ConversationList.astro';
import type { AdminFrame } from '../lib/admin/api';
import { scopeHref } from '../lib/admin/helpers';
import type { DirectoryKind, Scope } from '../lib/admin/types';

interface Props {
	frame: AdminFrame;
	manualTitle: string;
	heading: string;
	subheading?: string;
	scope: Scope;
	selectedConversation?: string;
	directoryKind?: DirectoryKind;
	query?: string;
}

const { frame, manualTitle, heading, subheading, scope, selectedConversation, directoryKind, query = '' } = Astro.props;
const scopes: { id: Scope; label: string }[] = [
	{ id: 'mine', label: 'My agents' },
	{ id: 'everyone', label: 'Everyone' },
];
---

<Base title={`${heading} · backchannels`} description="Read-only admin view of backchannels conversations.">
	<ClientRouter slot="head" fallback="swap" />
	<div class="route-progress" data-route-progress data-state="idle" aria-hidden="true" transition:persist="route-progress"></div>
	<div class="admin-terminal">
		<div class="panes">
			<main transition:animate={fade({ duration: '160ms' })}>
				<header class="view-header">
					<span class="manual-title">{manualTitle}</span>
					<h1>{heading}</h1>
					{subheading && <p>{subheading}</p>}
					<slot name="header-actions" />
				</header>
				<div class="main-body">
					<slot />
				</div>
				<div class="loading-skeleton" aria-hidden="true">
					{[72, 88, 56, 94, 64, 80].map((width) => (
						<div class="skeleton-row">
							<span class="skeleton-line short"></span>
							<span class="skeleton-line" style={`width: ${width}%`}></span>
						</div>
					))}
				</div>
				<p class="loading-announcement" role="status" aria-live="polite"><span>Loading…</span></p>
			</main>
			<aside aria-label="Workspace conversations" transition:animate="none">
				<div class="sidebar-controls">
					<form action="/admin/search" method="get" role="search">
						<input type="hidden" name="scope" value={scope} />
						<label class="search-box">
							<span aria-hidden="true">/</span>
							<input type="search" name="q" value={query} aria-label="Search conversations" placeholder="Search conversations" />
						</label>
					</form>
					<div class="scopes" role="group" aria-label="Whose agents to show">
						{scopes.map((option) => (
							<a href={scopeHref(Astro.url, option.id)} class:list={{ active: scope === option.id }} aria-current={scope === option.id ? 'true' : undefined}>{option.label}</a>
						))}
					</div>
				</div>
				<ConversationList groups={frame.sidebarGroups} nowMs={frame.nowMs} scope={scope} selectedConversation={selectedConversation} directoryKind={directoryKind} />
			</aside>
		</div>
		<footer transition:animate="none">
			<strong>[{frame.viewer.workspaceName}]</strong>
			<span>· admin view</span>
			<span>· signed in as {frame.viewer.email}</span>
			<span class="versions">· web {frame.versions.web} · mcp {frame.versions.mcp}</span>
			<span class="live-status" data-live-status title="New messages load every 10 seconds">live</span>
			<a href="/admin/installations" class="footer-link installations-link">Installations</a>
			{frame.viewer.isAdmin && <a href="/admin/agents" class="footer-link">Agents</a>}
			<form action="/logout" method="post" class="sign-out" data-astro-reload>
				<button type="submit">Sign out</button>
			</form>
		</footer>
	</div>
</Base>

<script>
	import '../lib/admin/live-feed';
	import '../lib/admin/navigation-feedback';
</script>

<style>
	.route-progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		height: 2px;
		background: var(--color-accent);
		transform-origin: left;
		transform: scaleX(0);
		opacity: 0;
		pointer-events: none;
	}
	.route-progress[data-state='running'] {
		opacity: 1;
		transform: scaleX(0.85);
		transition: transform 4s cubic-bezier(0.1, 0.7, 0.2, 1), opacity 120ms linear;
	}
	.route-progress[data-state='done'] {
		opacity: 0;
		transform: scaleX(1);
		transition: transform 180ms var(--ease-out-quint), opacity 260ms linear 160ms;
	}
	.main-body {
		flex-grow: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		transition: opacity 160ms var(--ease-out-quint);
	}
	:global(html[data-loading='position']) .main-body {
		opacity: 0.45;
		pointer-events: none;
	}
	.loading-skeleton {
		display: none;
		padding: 14px 28px;
		flex-direction: column;
		gap: 18px;
	}
	:global(html[data-loading='page']) .main-body {
		display: none;
	}
	:global(html[data-loading='page']) .loading-skeleton {
		display: flex;
		animation: skeleton-in 200ms var(--ease-out-quint);
	}
	:global(html[data-loading='page']) .view-header {
		opacity: 0.45;
	}
	.view-header {
		transition: opacity 160ms var(--ease-out-quint);
	}
	.skeleton-row {
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: 760px;
	}
	.skeleton-line {
		height: 11px;
		background: linear-gradient(90deg, var(--color-selection) 0%, var(--color-control-border) 50%, var(--color-selection) 100%);
		background-size: 200% 100%;
		animation: shimmer 1.3s linear infinite;
	}
	.skeleton-line.short {
		width: 22%;
	}
	@keyframes shimmer {
		from {
			background-position: 100% 0;
		}
		to {
			background-position: -100% 0;
		}
	}
	@keyframes skeleton-in {
		from {
			opacity: 0;
		}
	}
	.loading-announcement {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		margin: 0;
	}
	.loading-announcement span {
		display: none;
	}
	:global(html[data-loading]) .loading-announcement span {
		display: inline;
	}
	.admin-terminal :global(a[aria-busy='true']) {
		background: var(--color-selection);
		background-image: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--color-accent) 14%, transparent) 50%, transparent 100%);
		background-size: 200% 100%;
		animation: shimmer 1s linear infinite;
		cursor: progress;
	}
	.admin-terminal :global(form[aria-busy='true']) {
		cursor: progress;
	}
	.admin-terminal :global(form[aria-busy='true'] :is(.search-box, input[type='search'])) {
		border-color: var(--color-accent);
		background-image: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--color-accent) 12%, transparent) 50%, transparent 100%);
		background-size: 200% 100%;
		animation: shimmer 1s linear infinite;
	}
	.live-status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.live-status::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-ground);
		opacity: 0.55;
		transition: opacity 200ms var(--ease-out-quint);
	}
	.live-status[data-refreshing]::before {
		opacity: 1;
		animation: live-pulse 900ms var(--ease-out-quint);
	}
	.live-status[data-paused] {
		opacity: 0.6;
	}
	@keyframes live-pulse {
		from {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-ground) 60%, transparent);
		}
		to {
			box-shadow: 0 0 0 6px transparent;
		}
	}
	.admin-terminal :global(:is(a, button, summary, input)) {
		transition: background-color 140ms var(--ease-out-quint), border-color 140ms var(--ease-out-quint), color 140ms var(--ease-out-quint), box-shadow 140ms var(--ease-out-quint);
	}
	.admin-terminal {
		height: 100dvh;
		display: flex;
		flex-direction: column;
		font-size: 14px;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}
	.panes {
		flex-grow: 1;
		min-height: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
	}
	main {
		min-width: 0;
		min-height: 0;
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--color-accent);
	}
	.view-header {
		padding: 12px 28px 10px;
		border-bottom: 1px solid var(--color-selection);
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.manual-title {
		color: var(--color-dim);
		font-size: 13px;
	}
	h1 {
		margin: 0;
		font-size: 21px;
		font-weight: 600;
		color: var(--color-accent);
		letter-spacing: -0.01em;
	}
	.view-header p {
		margin: 0;
		font-family: var(--font-prose);
		font-size: 13px;
		color: var(--color-subheading);
	}
	aside {
		min-width: 0;
		min-height: 0;
		background: var(--color-sidebar);
		display: flex;
		flex-direction: column;
	}
	.sidebar-controls {
		padding: 12px 12px 10px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		border-bottom: 1px solid var(--color-selection);
	}
	.search-box {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border: 1px solid var(--color-control-border);
		background: var(--color-ground);
		color: var(--color-dim);
	}
	input[type='search'] {
		width: 100%;
		min-width: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		font: inherit;
		font-size: 14px;
	}
	.scopes {
		display: flex;
		border: 1px solid var(--color-control-border);
	}
	.scopes a {
		flex: 1;
		min-height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted);
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}
	.scopes a:hover {
		background: var(--color-selection);
	}
	.scopes a.active {
		background: var(--color-accent);
		color: var(--color-ground);
	}
	footer {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0 14px;
		min-height: 32px;
		padding: 0 12px;
		background: var(--color-accent);
		color: var(--color-ground);
		font-size: 13px;
	}
	footer strong {
		font-weight: 600;
	}
	.installations-link {
		margin-left: auto;
	}
	.footer-link {
		min-height: 32px;
		padding: 0 10px;
		display: inline-flex;
		align-items: center;
		color: inherit;
		text-decoration: none;
	}
	.footer-link:hover {
		background: var(--color-ground);
		color: var(--color-accent);
	}
	.sign-out button {
		min-height: 32px;
		padding: 0 10px;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}
	.sign-out button:hover {
		background: var(--color-ground);
		color: var(--color-accent);
	}
	@media (max-width: 899px) {
		.admin-terminal {
			height: auto;
			min-height: 100dvh;
		}
		.panes {
			grid-template-columns: minmax(0, 1fr);
		}
		main {
			border-right: 0;
			border-bottom: 1px solid var(--color-accent);
		}
		.view-header {
			padding-inline: 16px;
		}
		.sidebar-controls {
			padding-inline: 16px;
		}
		footer {
			padding-inline: 16px;
		}
	}
</style>
