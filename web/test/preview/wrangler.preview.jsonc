{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "backchannels-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "assets": { "directory": "../../dist", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "SESSION", "id": "fd9b111ca70f414f976c5e4f3403551e" }],
  "services": [{ "binding": "ADMIN_API", "service": "backchannels-admin-stub", "entrypoint": "AdminApi" }],
  "observability": { "enabled": true, "redact_query_string": true }
}
