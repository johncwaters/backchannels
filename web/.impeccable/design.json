      "refersTo": "key-reveal",
      "description": "Square bordered container for the one-time key reveal.",
      "html": "<section class=\"ds-key-card\" aria-label=\"New headless key\"><h2 class=\"ds-key-title\">Key created: deploy agent</h2><p class=\"ds-key-copy\">Copy this key now. backchannels shows it only this one time.</p><code class=\"ds-key-code\">example-key</code></section>",
      "css": ".ds-key-card{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--color-accent);border-radius:0;background:var(--color-sidebar);color:var(--color-text);font-family:var(--font-mono)}.ds-key-title{margin:0;font-size:15px;font-weight:600;color:var(--color-accent)}.ds-key-copy{margin:0;font-family:var(--font-prose);font-size:14px;line-height:1.45;color:var(--color-subheading)}.ds-key-code{padding:8px 12px;border:1px solid var(--color-control-border);background:var(--color-ground);font-family:var(--font-mono);font-size:15px;font-weight:600;overflow-wrap:anywhere}@media(prefers-reduced-motion:reduce){.ds-key-card,.ds-key-title,.ds-key-copy,.ds-key-code{transition-duration:1ms}}"
    },
    {
      "name": "Incoming activity row",
      "kind": "custom",
      "refersTo": "activity-row",
      "description": "Identity, message context, excerpt, reply status, and direct links in a plain row.",
      "html": "<article class=\"ds-activity\"><div class=\"ds-activity-meta\"><span>Incoming</span><span class=\"ds-activity-identity\"><strong>john.w</strong><span class=\"ds-activity-agent\">/deploy-agent</span></span><time class=\"ds-activity-time\" datetime=\"2026-10-01T08:13:00Z\">today 08:13</time></div><a class=\"ds-activity-message\" href=\"#message\"><span class=\"ds-activity-context\">in <span>#deploys</span></span><p class=\"ds-activity-excerpt\">I will cut the release branch Thursday.</p></a><div class=\"ds-activity-actions\"><span class=\"ds-activity-answered\">Answered</span><a class=\"ds-activity-link\" href=\"#reply\">Read ian.m/deploy-agent\\u0027s reply</a><a class=\"ds-activity-link ds-activity-open\" href=\"#message\">Open message →</a></div></article>",
      "css": ".ds-activity{display:flex;max-width:900px;flex-direction:column;gap:6px;padding:16px 0;border-bottom:1px solid var(--color-row-border);font-family:var(--font-mono);color:var(--color-text)}.ds-activity-meta,.ds-activity-actions{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:10px;row-gap:4px;font-size:12px;line-height:16px;color:var(--color-dim)}.ds-activity-identity{min-width:0;font-size:14px;line-height:1.45;overflow-wrap:anywhere}.ds-activity-identity strong{font-weight:600;color:var(--color-text)}.ds-activity-agent{color:var(--agent-claude-code)}.ds-activity-time{margin-left:auto;white-space:nowrap;font-variant-numeric:tabular-nums}.ds-activity-message{display:flex;flex-direction:column;gap:4px;color:inherit;text-decoration:none}.ds-activity-context{font-size:12px;line-height:16px;color:var(--color-dim)}.ds-activity-context span{color:var(--color-subheading)}.ds-activity-excerpt{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;margin:0;font-family:var(--font-prose);font-size:15px;line-height:1.5;color:var(--color-message)}.ds-activity-message:hover .ds-activity-context span{color:var(--color-accent)}.ds-activity-message:hover .ds-activity-excerpt{color:var(--color-text)}.ds-activity-answered{color:var(--agent-codex)}.ds-activity-link{color:var(--color-accent);text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--color-accent) 40%,transparent);text-underline-offset:3px}.ds-activity-link:hover{text-decoration-color:var(--color-accent)}.ds-activity-open{margin-left:auto}.ds-activity-message:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}.ds-activity-link:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-activity,.ds-activity-meta,.ds-activity-actions,.ds-activity-identity,.ds-activity-agent,.ds-activity-time,.ds-activity-message,.ds-activity-context,.ds-activity-excerpt,.ds-activity-answered,.ds-activity-link,.ds-activity-open{transition-duration:1ms}}"
    },
    {
      "name": "Adaptive brandmark",
      "kind": "custom",
      "description": "Two offset chat panes with opposite tails; exact favicon geometry with light and dark color modes.",
      "html": "<svg class=\"ds-brandmark\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" role=\"img\" aria-labelledby=\"ds-brand-title\"><title id=\"ds-brand-title\">backchannels</title><desc>Two offset chat panes with opposite tails.</desc><path class=\"ds-brand-pane\" d=\"M4 4H24V18H12L4 24Z\"/><path class=\"ds-brand-pane\" d=\"M12 12H28V28L22 24H12Z\"/></svg>",
      "css": ".ds-brandmark{display:block;width:32px;height:32px}.ds-brand-pane{fill:#fff;stroke:var(--color-ground);stroke-width:3;stroke-linejoin:miter}@media(prefers-color-scheme:dark){.ds-brand-pane{fill:var(--color-ground);stroke:var(--color-accent)}}"
    }
  ],
  "narrative": {
    "northStar": "M1 · Man in a pane",
    "overview": "A man page sits inside a tmux frame. Amber controls and rules divide a near-black field. The interface uses dense, plain rows.\n\nThe public page explains the service through manual sections and a shell pane. The admin view carries this same structure into conversations and activity.",
    "keyCharacteristics": [
      "Amber navigation and ownership cues.",
      "Monospaced controls with sans-serif prose.",
      "Square controls, thin dividers, and plain rows.",
      "Immediate navigation feedback and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Ownership Rule",
        "body": "Amber identifies the viewer's own name. Agent hues remain distinct from amber.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use mono for controls and identities. Use sans-serif for message text and explanations.",
        "section": "typography"
      },
      {
        "name": "The Flat Rows Rule",
        "body": "Activity and conversation rows remain part of the pane. Use dividers and state cues to separate them.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the source tokens and the two type families.",
      "Do keep activity in plain rows with direct message links.",
      "Do place unread and count badges before their labels.",
      "Do preserve immediate feedback and visible focus.",
      "Do describe reply status as found versus not found."
    ],
    "donts": [
      "Don't use amber as an agent identity hue.",
      "Don't replace activity rows with separate floating cards.",
      "Don't describe Answered as task completion.",
      "Don't use faint status color without a text label."
    ]
  }
}
