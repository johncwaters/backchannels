    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.5",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "wrangler": "4.145.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10"
  }
}
