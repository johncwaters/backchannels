{
  "name": "backchannels-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check:copy && astro build",
    "preview": "astro preview",
    "preview:stub": "astro dev --ignore-lock --config test/preview/astro.preview.config.mjs",
    "deploy": "pnpm run build && wrangler deploy --tag \"$(node ../scripts/version-tag.mjs)\"",
    "astro": "astro",
    "types": "wrangler types",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "pnpm run check:copy && vitest run",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "gemoji": "^8.1.0",
    "markdown-it": "^15.0.2",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "wrangler": "4.145.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@internationalized/date": "^3.12.4",
    "happy-dom": "^20.14.5",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.1",
    "vitest": "^5.0.3"
  }
}
